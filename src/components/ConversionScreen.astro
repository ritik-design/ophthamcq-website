---
import Icon from './Icon.astro';
import { PRODUCTS, COM_BASE } from '../config';
import type { Category } from '../data/categories';

export interface Props {
  category: Category;
}

const { category } = Astro.props;

const products = category.productIds
  .map((id) => PRODUCTS.find((p) => p.id === id))
  .filter(Boolean);
---

<div id={`conversion-${category.id}`} class="conversion-screen hidden">
  <div class="rounded-2xl bg-white border border-slate-200 shadow-sm overflow-hidden">
    <!-- Score recap -->
    <div class="px-6 py-8 text-center bg-gradient-to-br from-sky-500 to-sky-700 text-white">
      <div class="text-sm uppercase tracking-wide opacity-90">You scored</div>
      <div class="mt-2 text-5xl sm:text-6xl font-extrabold" data-score-display>0/0</div>
      <div class="mt-3 text-lg font-medium opacity-95">Ready for the full {category.name} preparation?</div>
    </div>

    <div class="p-6 lg:p-8 space-y-10">
      <!-- Included products -->
      <section>
        <h3 class="text-xl font-bold text-slate-900 mb-4">Unlock everything included in the full package</h3>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {products.map((product) => (
            <div class="rounded-xl border border-slate-200 bg-white p-4 flex flex-col">
              <div class="aspect-video rounded-lg bg-slate-100 overflow-hidden mb-4">
                <img
                  src={product?.image}
                  alt={product?.fullName}
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              </div>
              <h4 class="font-bold text-slate-900 mb-1">{product?.name}</h4>
              <p class="text-xs text-slate-600 line-clamp-2 mb-3 flex-1">{product?.description}</p>
              <div class="flex items-baseline gap-2 mb-3">
                <span class="text-lg font-bold text-slate-900">{product?.price}</span>
                {product?.oldPrice && (
                  <span class="text-sm text-slate-400 line-through">{product.oldPrice}</span>
                )}
                {product?.discount && (
                  <span class="text-xs font-medium text-emerald-600 bg-emerald-50 px-1.5 py-0.5 rounded">
                    Save {product.discount}
                  </span>
                )}
              </div>
              <a
                href={product?.href}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700 transition-colors"
              >
                Buy Now
                <Icon name="externalLink" class="h-4 w-4" />
              </a>
            </div>
          ))}
        </div>
      </section>

      <!-- Benefits -->
      <section class="rounded-2xl bg-slate-50 border border-slate-200 p-6">
        <h3 class="text-lg font-bold text-slate-900 mb-4">Inside the full package</h3>
        <div class="grid sm:grid-cols-2 gap-3">
          {category.benefits.map((benefit) => (
            <div class="flex items-start gap-3">
              <Icon name="check" class="h-5 w-5 text-emerald-500 shrink-0 mt-0.5" />
              <span class="text-sm text-slate-700">{benefit}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- Included topics and resources -->
      <section class="grid md:grid-cols-2 gap-6">
        <div class="rounded-2xl bg-white border border-slate-200 p-6">
          <h4 class="text-base font-bold text-slate-900 mb-4 flex items-center gap-2">
            <Icon name="bookOpen" class="h-5 w-5 text-sky-600" /
            Included Topics
          </h4>
          <ul class="space-y-2">
            {category.includedTopics.map((topic) => (
              <li class="flex items-center gap-2 text-sm text-slate-700">
                <span class="text-emerald-500 font-bold">✓</span>
                {topic}
              </li>
            ))}
          </ul>
        </div>

        <div class="rounded-2xl bg-white border border-slate-200 p-6">
          <h4 class="text-base font-bold text-slate-900 mb-4 flex items-center gap-2">
            <Icon name="document" class="h-5 w-5 text-sky-600" /
            Included Resources
          </h4>
          <ul class="space-y-2">
            {category.includedResources.map((resource) => (
              <li class="flex items-center gap-2 text-sm text-slate-700">
                <span class="text-emerald-500 font-bold">✓</span>
                {resource}
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- Main CTA -->
      <section class="text-center">
        <a
          href={`${COM_BASE}/new-courses`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-600 px-8 py-4 text-base font-semibold text-white shadow-lg hover:bg-emerald-700 transition-colors"
        >
          Buy the Full {category.name} Package
          <Icon name="externalLink" class="h-5 w-5" />
        </a>
        <p class="mt-3 text-sm text-slate-500">Instant access after purchase. Available on Android & iOS app.</p>
      </section>
    </div>
  </div>

  <div class="mt-6 text-center">
    <button
      type="button"
      id="btn-reset"
      class="inline-flex items-center gap-2 rounded-xl bg-white px-6 py-3 text-sm font-semibold text-slate-700 border-2 border-slate-200 hover:border-sky-300 hover:text-sky-700 transition-all"
    >
      Try Another Category
      <Icon name="arrowRight" class="h-4 w-4" />
    </button>
  </div>
</div>
