---
import Icon from './Icon.astro';
import type { Category } from '../data/categories';

export interface Props {
  category: Category;
}

const { category } = Astro.props;
---

<div
  class="group relative flex flex-col rounded-2xl bg-white border border-slate-200 p-6 shadow-sm hover:shadow-lg hover:border-sky-200 transition-all"
>
  <div class="mb-4 flex items-center justify-between">
    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-sky-50 text-sky-600 group-hover:bg-sky-600 group-hover:text-white transition-colors">
      <Icon name={category.iconName} class="h-6 w-6" />
    </div>
    <span class="inline-flex items-center rounded-full bg-emerald-50 border border-emerald-100 px-2.5 py-0.5 text-xs font-semibold text-emerald-700">
      {category.fullQuestionCount} MCQs
    </span>
  </div>

  <h3 class="text-lg font-bold text-slate-900 mb-2">{category.name}</h3>
  <p class="text-sm text-slate-600 leading-relaxed mb-6 flex-1">{category.description}</p>

  <a
    href={`/free-mcqs/${category.id}/`}
    class="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-sky-600 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-sky-700 transition-colors"
  >
    Start Free Quiz
    <Icon name="arrowRight" class="h-4 w-4" />
  </a>
</div>
