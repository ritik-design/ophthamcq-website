---
import { PRODUCTS, TESTIMONIALS } from '../../config';
import Icon from '../Icon.astro';

const byId = Object.fromEntries(PRODUCTS.map(p => [p.id, p]));

const flagship = byId['retina-deciphered'];

const featuredNoteCards = [
  { id: 'retina-deciphered', badge: 'Most Popular', badgeColor: 'sky' },
  { id: 'glaucoma-notes', badge: 'Top Seller', badgeColor: 'amber' },
  { id: 'optics-notes', badge: 'Premium', badgeColor: 'violet' },
  { id: 'anatomy-notes', badge: 'Basics', badgeColor: 'sky' },
] as const;

const badgeClasses: Record<string, string> = {
  sky: 'bg-sky-50 border-sky-200 text-sky-700',
  amber: 'bg-amber-50 border-amber-200 text-amber-700',
  violet: 'bg-violet-50 border-violet-200 text-violet-700',
  emerald: 'bg-emerald-50 border-emerald-200 text-emerald-700',
};

const proofBullets = [
  'Genuine handwriting — scanned crisp for phone & print',
  '120–250 pages per topic with exam-style diagrams',
  'Lifetime access · PDF + iOS/Android app sync',
  'From ₹249 per topic',
];

const quote =
  TESTIMONIALS.find(t => t.name.includes('Garvesh')) ?? TESTIMONIALS[1];
---

<section
  id="exam-ready-notes"
  class="section-skin-grid py-20 lg:py-28"
  aria-labelledby="exam-ready-notes-heading"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <div data-reveal="left">
        <div class="inline-flex items-center gap-2 rounded-full bg-sky-50 border border-sky-100 px-3 py-1 mb-5 shadow-sm">
          <Icon name="notes" class="w-4 h-4 text-sky-600" />
          <span class="text-xs font-bold uppercase tracking-wide text-sky-700">
            Handwritten · Not Typed PDFs
          </span>
        </div>

        <h2
          id="exam-ready-notes-heading"
          class="font-display text-3xl sm:text-4xl font-semibold text-slate-900 tracking-tight leading-tight"
        >
          Exam Ready Notes Handwritten for PG Ophthalmologists
        </h2>

        <p class="mt-5 text-lg text-slate-600 leading-relaxed max-w-xl">
          Genuinely handwritten pages distilled from Kanski, Ryan, Elkington and BCSC —
          built by ophthalmologists who cleared FRCOphth, ICO/FICO, FAICO, DNB and NEET-SS.
          Revise a full topic in 45–90 minutes, not a weekend.
        </p>

        <ul class="mt-7 space-y-3">
          {proofBullets.map(item => (
            <li class="flex items-start gap-3 text-slate-700">
              <span class="shrink-0 mt-0.5 w-5 h-5 rounded-full bg-sky-50 border border-sky-100 inline-flex items-center justify-center">
                <Icon name="check" class="w-3.5 h-3.5 text-sky-600" />
              </span>
              <span class="text-sm sm:text-base leading-snug">{item}</span>
            </li>
          ))}
        </ul>

        <div class="mt-9 flex flex-col sm:flex-row gap-3">
          <a
            href="/notes"
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-sky-600 px-6 py-3.5 text-base font-semibold text-white shadow-lg shadow-sky-200 hover:bg-sky-700 transition-colors"
          >
            Browse All Note Sets
            <Icon name="arrowRight" class="w-5 h-5" />
          </a>
          <a
            href="/products/retina-deciphered"
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-white px-6 py-3.5 text-base font-semibold text-slate-700 border-2 border-slate-200 hover:border-sky-300 hover:text-sky-700 transition-colors"
          >
            Preview Retina Deciphered
          </a>
        </div>

        {quote && (
          <blockquote class="mt-8 rounded-2xl border border-slate-200 bg-slate-50 px-5 py-4">
            <p class="text-sm text-slate-700 leading-relaxed italic">
              “{quote.text}”
            </p>
            <footer class="mt-2 text-xs font-semibold text-slate-500">
              — {quote.name}, {quote.role}
            </footer>
          </blockquote>
        )}
      </div>

      {flagship && (
        <div class="relative" data-reveal="right">
          <div class="absolute -inset-4 rounded-[1.75rem] bg-gradient-to-br from-sky-200/40 via-transparent to-amber-100/30 blur-2xl -z-10" aria-hidden="true"></div>
          <div class="rounded-2xl overflow-hidden bg-amber-50/40 border border-slate-200 shadow-xl ring-1 ring-slate-100 transition-transform duration-500 hover:-translate-y-1">
            <div class="aspect-[4/5] sm:aspect-[3/4] bg-slate-100 overflow-hidden">
              <img
                src={flagship.image}
                alt={flagship.fullName}
                loading="lazy"
                class="w-full h-full object-cover"
              />
            </div>
            <div class="p-4 sm:p-5 flex flex-wrap items-center justify-between gap-3 bg-white/90 border-t border-slate-100">
              <div>
                <p class="text-sm font-bold text-slate-900">{flagship.name}</p>
                <p class="text-xs text-slate-500 mt-0.5">Flagship handwritten set</p>
              </div>
              <div class="flex items-center gap-2">
                <span class="inline-flex items-center rounded-full border border-sky-200 bg-sky-50 px-2.5 py-0.5 text-xs font-semibold text-sky-700">
                  Most Popular
                </span>
                <span class="text-lg font-bold text-slate-900">{flagship.price}</span>
              </div>
            </div>
          </div>
        </div>
      )}
    </div>

    <!-- 4-up product grid (includes retina again — intentional dual surface) -->
    <div class="mt-14 lg:mt-16 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6" data-stagger>
      {featuredNoteCards.map(c => {
        const p = byId[c.id];
        if (!p) return null;
        return (
          <div class="group relative flex flex-col rounded-2xl border border-slate-200 bg-white overflow-hidden hover:shadow-lg hover:border-sky-200 transition-all duration-300">
            <div class="absolute top-3 left-3 z-10">
              <span
                class:list={[
                  'inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wide',
                  badgeClasses[c.badgeColor],
                ]}
              >
                {c.badge}
              </span>
            </div>

            <div class="h-44 bg-slate-100 overflow-hidden">
              <img
                src={p.image}
                alt={p.fullName}
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              />
            </div>

            <div class="flex flex-col flex-1 p-5">
              <h3 class="text-base font-bold text-slate-900 mb-1">{p.name}</h3>
              <p class="text-sm text-slate-600 leading-relaxed mb-4 flex-1 line-clamp-2">
                {p.description}
              </p>

              <div class="flex items-baseline gap-2 mb-4 flex-wrap">
                <span class="text-xl font-bold text-slate-900">{p.price}</span>
                {p.oldPrice && (
                  <span class="text-sm text-slate-400 line-through">{p.oldPrice}</span>
                )}
                {p.discount && (
                  <span class="text-xs font-medium text-emerald-700 bg-emerald-50 border border-emerald-200 px-1.5 py-0.5 rounded">
                    Save {p.discount}
                  </span>
                )}
              </div>

              <div class="flex flex-col gap-2">
                <a
                  href={`/products/${p.id}`}
                  class="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 border-2 border-slate-200 hover:border-sky-300 hover:text-sky-700 transition-colors"
                >
                  Preview
                </a>
                <a
                  href={p.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-sky-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-sky-700 transition-colors"
                >
                  Buy Now
                  <Icon name="externalLink" class="w-4 h-4" />
                </a>
              </div>
            </div>
          </div>
        );
      })}
    </div>

    <div class="mt-10 flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-sm text-slate-500">
      <span class="font-medium text-slate-600">More topics:</span>
      <a href="/products/eyelids-notes" class="hover:text-sky-700 underline-offset-2 hover:underline">Eyelids</a>
      <span aria-hidden="true">·</span>
      <a href="/products/recent-advances-ophthalmology-notes" class="hover:text-sky-700 underline-offset-2 hover:underline">Recent Advances</a>
      <span aria-hidden="true">·</span>
      <a href="/products/rings-dots-lines-spots-guide" class="hover:text-sky-700 underline-offset-2 hover:underline">Rings · Dots · Lines · Spots</a>
      <span aria-hidden="true">·</span>
      <a href="/notes" class="font-semibold text-sky-700 hover:text-sky-800 inline-flex items-center gap-1">
        All note sets
        <Icon name="chevronRight" class="w-4 h-4" />
      </a>
    </div>
  </div>
</section>
