---
/**
 * Homepage section: Ophthalmology Practical / OSCE / Viva complete data PDFs.
 * Resources are separate from Exam Ready handwritten notes.
 */
import Icon from '../Icon.astro';
import { COM_BASE } from '../../config';
import {
  PRACTICAL_RESOURCES,
  practicalStoreHref,
  practicalProduct,
} from '../../data/practical-pdfs';

const stations = [
  { title: 'OSCE Stations', body: 'Communication, examination and data interpretation.' },
  { title: 'Instruments', body: 'Parts, uses and viva-ready identification.' },
  { title: 'Case Presentation', body: 'Long/short case templates for practicals.' },
  { title: 'Investigations', body: 'OCT, FFA, fields, USG — read and present.' },
  { title: 'Viva Voce', body: 'Hot questions with structured 60-second answers.' },
];
---

<section
  id="practical-osce"
  class="section-skin-blue"
  aria-labelledby="practical-osce-heading"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mb-10 lg:mb-12" data-reveal>
      <div class="inline-flex items-center gap-2 rounded-full bg-emerald-50 border border-emerald-200 px-3 py-1 mb-5">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span class="text-xs font-bold uppercase tracking-wide text-emerald-800">
          New Launch · DNB / MS / DO Practical
        </span>
      </div>
      <h2
        id="practical-osce-heading"
        class="font-display text-3xl sm:text-4xl font-semibold text-slate-900 tracking-tight leading-tight"
      >
        Ophthalmology Practical / OSCE / Viva Complete Data / PDF
      </h2>
      <p class="mt-4 text-lg text-slate-700 leading-relaxed max-w-2xl">
        Complete practical exam pack — OSCE stations, instruments, case lists, drugs and viva data.
        Browse the PDFs below, then get lifetime access on{' '}
        <span class="font-semibold">ophthamcq.com</span>.
      </p>
      <div class="mt-6 flex flex-col sm:flex-row gap-3">
        <a
          href="/osce"
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-600 px-6 py-3.5 text-base font-semibold text-white shadow-lg shadow-emerald-900/10 hover:bg-emerald-700 transition-colors"
        >
          Explore OSCE Bundle
          <Icon name="arrowRight" class="w-5 h-5" />
        </a>
        <a
          href={COM_BASE}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-white px-6 py-3.5 text-base font-semibold text-slate-800 border-2 border-slate-200 hover:border-emerald-300 hover:text-emerald-800 transition-colors"
        >
          Browse store for practical resources
          <Icon name="externalLink" class="w-4 h-4" />
        </a>
      </div>
    </div>

    <!-- Station chips -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-12" data-stagger>
      {stations.map(s => (
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <div class="w-9 h-9 rounded-lg bg-emerald-50 border border-emerald-100 flex items-center justify-center mb-3">
            <Icon name="check" class="w-5 h-5 text-emerald-600" />
          </div>
          <h3 class="text-sm font-bold text-slate-900 mb-1">{s.title}</h3>
          <p class="text-sm text-slate-600 leading-relaxed">{s.body}</p>
        </div>
      ))}
    </div>

    <!-- Practical PDF / data cards -->
    <div class="mb-4">
      <h3 class="text-sm font-semibold uppercase tracking-widest text-slate-600 mb-1">
        Complete data / PDFs
      </h3>
      <p class="text-sm text-slate-600 mb-6">
        Open each resource, then buy the matching product on the store.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6" data-stagger>
      {PRACTICAL_RESOURCES.map(r => {
        const product = practicalProduct(r);
        const store = practicalStoreHref(r);
        return (
          <article class="group flex flex-col rounded-2xl border border-slate-200 bg-white overflow-hidden shadow-sm hover:shadow-lg hover:border-emerald-200 transition-all">
            <div class="relative h-44 bg-slate-100 overflow-hidden">
              <img
                src={r.thumb}
                alt={r.title}
                loading="lazy"
                class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-300"
              />
              {r.badge && (
                <span class="absolute top-3 left-3 inline-flex items-center rounded-full bg-emerald-50 border border-emerald-200 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wide text-emerald-800">
                  {r.badge}
                </span>
              )}
              <span class="absolute top-3 right-3 inline-flex items-center rounded-full bg-white/95 border border-slate-200 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-slate-600">
                {r.kind === 'pdf' ? 'PDF' : 'Cover'}
              </span>
            </div>

            <div class="flex flex-col flex-1 p-5">
              <h3 class="text-base font-bold text-slate-900 mb-1.5 leading-snug">{r.title}</h3>
              <p class="text-sm text-slate-600 leading-relaxed mb-4 flex-1">{r.description}</p>

              {product && (
                <div class="flex items-baseline gap-2 mb-4 flex-wrap">
                  <span class="text-lg font-bold text-slate-900">{product.price}</span>
                  {product.oldPrice && (
                    <span class="text-sm text-slate-400 line-through">{product.oldPrice}</span>
                  )}
                  {product.discount && (
                    <span class="text-xs font-medium text-emerald-700 bg-emerald-50 border border-emerald-200 px-1.5 py-0.5 rounded">
                      Save {product.discount}
                    </span>
                  )}
                </div>
              )}

              <div class="flex flex-col gap-2">
                {r.pdf ? (
                  <a
                    href={r.pdf}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 border-2 border-slate-200 hover:border-emerald-300 hover:text-emerald-800 transition-colors"
                  >
                    Open full PDF
                    <Icon name="document" class="w-4 h-4" />
                  </a>
                ) : (
                  <a
                    href="/osce"
                    class="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 border-2 border-slate-200 hover:border-emerald-300 hover:text-emerald-800 transition-colors"
                  >
                    View OSCE page
                    <Icon name="arrowRight" class="w-4 h-4" />
                  </a>
                )}
                <a
                  href={store}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-emerald-700 transition-colors"
                >
                  Buy on ophthamcq.com
                  <Icon name="externalLink" class="w-4 h-4" />
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <p class="mt-8 text-center text-sm text-slate-600">
      Handwritten theory notes (Retina, Glaucoma, Anatomy…) live in the{' '}
      <a href="#exam-ready-notes" class="font-semibold text-sky-800 underline-offset-2 hover:underline">
        Exam Ready Notes
      </a>{' '}
      section above — this block is practical / OSCE / viva only.
    </p>
  </div>
</section>
