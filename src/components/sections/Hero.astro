---
import Icon from '../Icon.astro';
---

<section class="bg-white">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 pt-16 pb-14 lg:pt-24 lg:pb-20">
    <div class="text-center">
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 tracking-tight leading-[1.1]">
        The World's Only Ophthalmology PG
        <span class="block mt-2">Exam Notes &amp; MCQ Question Bank.</span>
      </h1>

      <p class="mt-6 text-lg sm:text-xl font-medium text-slate-500">
        By Ophthalmologists. For Ophthalmologists.
      </p>

      <p class="mt-6 text-base sm:text-lg text-slate-600 max-w-3xl mx-auto leading-relaxed">
        20,000+ exam-pattern MCQs and handwritten exam ready notes
        built for ICO/FICO, FAICO, FRCOphth, DNB and PDCET.
        Trusted by 15,000+ PGs and residents across India and 23 countries.
      </p>

      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-3">
        <a
          href="/exams"
          class="w-full sm:w-auto inline-flex items-center justify-center rounded-xl bg-sky-600 px-6 py-3.5 text-base font-semibold text-white shadow-lg shadow-sky-200 hover:bg-sky-700 hover:shadow-xl hover:shadow-sky-300 transition-all duration-200"
        >
          Exam-Wise MCQs
          <Icon name="arrowRight" class="ml-2 h-5 w-5" />
        </a>
        <a
          href="/notes"
          class="w-full sm:w-auto inline-flex items-center justify-center rounded-xl bg-white px-6 py-3.5 text-base font-semibold text-slate-700 border-2 border-slate-200 hover:border-sky-300 hover:text-sky-700 transition-all duration-200"
        >
          Handwritten PG Exam Ready Notes
        </a>
        <a
          href="/exams"
          class="w-full sm:w-auto inline-flex items-center justify-center px-4 py-3.5 text-base font-semibold text-sky-700 hover:text-sky-800 transition-colors"
        >
          Browse by Exam
          <Icon name="chevronRight" class="ml-1 h-5 w-5" />
        </a>
      </div>
    </div>
  </div>
</section>
