---
import Icon from '../Icon.astro';
import AnimatedGradient from '../AnimatedGradient.astro';
---

<section class="relative overflow-hidden bg-slate-50/80">
  <AnimatedGradient />

  <div class="absolute inset-0 opacity-[0.03]" aria-hidden="true">
    <svg width="100%" height="100%">
      <defs>
        <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
          <path d="M 40 0 L 0 0 0 40" fill="none" stroke="currentColor" stroke-width="1"/>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#grid)"/>
    </svg>
  </div>

  <div class="relative mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 pt-16 pb-20 lg:pt-24 lg:pb-28">
    <div class="text-center">
      <div class="inline-flex items-center gap-2 rounded-full bg-white/70 border border-sky-100 px-4 py-1.5 mb-8 backdrop-blur-sm">
        <span class="relative flex h-2.5 w-2.5">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-sky-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-sky-500"></span>
        </span>
        <span class="text-sm font-medium text-sky-700">Trusted by 15,000+ Ophthalmology Residents</span>
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 tracking-tight leading-tight">
        The Only Ophthalmology Question Bank Built by
        <span class="text-sky-600">Doctors Who Passed These Exams</span>
      </h1>

      <p class="mt-6 text-lg sm:text-xl text-slate-600 max-w-2xl mx-auto leading-relaxed">
        10,000+ MCQs • Handwritten Notes • Past Papers with Explanations.
        For FRCOphth, ICO, FAICO, DNB &amp; NEET-SS.
      </p>

      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/free-mcqs" class="w-full sm:w-auto inline-flex items-center justify-center rounded-xl bg-sky-600 px-8 py-4 text-base font-semibold text-white shadow-lg shadow-sky-200 hover:bg-sky-700 hover:shadow-xl hover:shadow-sky-300 transition-all duration-200">
          Start Free Practice
          <Icon name="arrowRight" class="ml-2 h-5 w-5" />
        </a>
        <a href="/exams" class="w-full sm:w-auto inline-flex items-center justify-center rounded-xl bg-white/80 px-8 py-4 text-base font-semibold text-slate-700 border-2 border-slate-200/70 hover:border-slate-300 hover:bg-white transition-all duration-200 backdrop-blur-sm">
          Explore Exams
        </a>
      </div>

      <p class="mt-4 text-sm text-slate-500">
        50 free MCQs. No credit card. No signup required.
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-3 text-sm text-slate-500">
        <div class="flex items-center gap-1.5">
          <div class="flex text-amber-400">
            {[1,2,3,4,5].map(() => (
              <Icon name="star" class="w-4 h-4" />
            ))}
          </div>
          <span class="font-medium text-slate-700">4.8</span>
          <span>(2,400+ reviews)</span>
        </div>
        <div class="hidden sm:block w-px h-4 bg-slate-300"></div>
        <div class="flex items-center gap-2">
          <Icon name="trophy" class="w-4 h-4 text-slate-400" />
          <span class="font-medium text-slate-700">87%</span>
          <span>Pass Rate</span>
        </div>
      </div>
    </div>
  </div>
</section>
