---
import Icon from '../Icon.astro';
---

<section class="surface-slitlamp section-skin-grid relative">
  <!-- Soft floating orbs -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-[42rem] h-[42rem] rounded-full bg-sky-300/20 blur-3xl float-soft"></div>
    <div class="absolute top-1/3 -right-20 w-72 h-72 rounded-full bg-cyan-200/25 blur-3xl" style="animation-delay: -2s"></div>
    <div class="absolute bottom-0 left-0 w-64 h-64 rounded-full bg-indigo-200/15 blur-3xl"></div>
  </div>

  <div class="relative mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 pt-12 pb-12 sm:pt-14 sm:pb-14 lg:pt-16 lg:pb-16">
    <div class="hero-animate text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-sky-200/80 bg-white/70 backdrop-blur-sm px-3.5 py-1.5 shadow-sm mb-6 sm:mb-7">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full rounded-full bg-sky-400 opacity-60" style="animation: pulse-ring 2s cubic-bezier(0.22,1,0.36,1) infinite"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-sky-500"></span>
        </span>
        <span class="text-xs sm:text-sm font-semibold text-sky-800 tracking-wide">
          Trusted by 15,000+ PGs · 23 countries
        </span>
      </div>

      <h1 class="font-display mx-auto max-w-4xl text-4xl sm:text-5xl lg:text-[3.65rem] font-semibold text-slate-900 tracking-tight leading-[1.12]">
        The World's Only Ophthalmology PG Exam Notes &amp;
        <span class="text-gradient-clinical">MCQ Question Bank.</span>
      </h1>

      <p class="mt-6 text-lg sm:text-xl font-medium text-slate-500 tracking-wide">
        By Ophthalmologists. For Ophthalmologists.
      </p>

      <p class="mt-6 text-base sm:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed">
        20,000+ exam-pattern MCQs and handwritten exam ready notes
        built for ICO/FICO, FAICO, FRCOphth, DNB and PDCET.
      </p>

      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-3">
        <a
          href="/free-mcqs"
          class="btn-premium btn-premium-primary w-full sm:w-auto px-7 py-3.5 text-base"
        >
          Exam-Wise MCQs
          <Icon name="arrowRight" class="h-5 w-5" />
        </a>
        <a
          href="/notes"
          class="btn-premium btn-premium-secondary w-full sm:w-auto px-7 py-3.5 text-base"
        >
          Handwritten PG Exam Ready Notes
        </a>
        <a
          href="/exams"
          class="w-full sm:w-auto inline-flex items-center justify-center px-4 py-3.5 text-base font-semibold text-sky-700 hover:text-sky-900 transition-colors group"
        >
          Browse by Exam
          <Icon name="chevronRight" class="ml-1 h-5 w-5 transition-transform group-hover:translate-x-0.5" />
        </a>
      </div>
    </div>
  </div>

  <div class="section-divider relative" aria-hidden="true"></div>
</section>
