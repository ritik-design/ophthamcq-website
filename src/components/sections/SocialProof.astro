---
import { TESTIMONIALS } from '../../config';
import Icon from '../Icon.astro';

const institutions = [
  { icon: 'building', label: 'AIIMS',      sub: 'Trusted By Residents' },
  { icon: 'eye',      label: 'Aravind',    sub: 'Eye Hospital' },
  { icon: 'shield',   label: 'LVPEI',      sub: 'Eye Institute' },
  { icon: 'globe',    label: 'Moorfields', sub: 'Eye Hospital UK' },
  { icon: 'heart',    label: 'Sankara',    sub: 'Nethralaya' },
];

const reviewLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'OphthaMCQ Ophthalmology Exam Preparation',
  description: 'Ophthalmology PG exam notes and MCQ question bank for ICO/FICO, FAICO, FRCOphth, DNB, MS, DO and PDCET.',
  brand: { '@type': 'Brand', name: 'OphthaMCQ' },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.8',
    reviewCount: '2400',
    bestRating: '5',
  },
  review: TESTIMONIALS.map(t => ({
    '@type': 'Review',
    reviewRating: { '@type': 'Rating', ratingValue: '5', bestRating: '5' },
    author: { '@type': 'Person', name: t.name, jobTitle: t.role },
    reviewBody: t.text,
  })),
};
---

<section class="bg-white py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 tracking-tight">
        Ophthalmologists Who Passed. In Their Own Words.
      </h2>
      <p class="mt-4 text-lg text-slate-600">
        Verified reviews from ophthalmology residents and PGs who cleared ICO/FICO, FAICO, FRCOphth, DNB, MS, DO and PDCET using OphthaMCQ notes and question banks. Trusted by 15,000+ residents across 23 countries with a 4.8/5 rating from 2,400+ reviews.
      </p>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-slate-50/60 px-6 py-8 mb-12">
      <p class="text-center text-xs font-semibold uppercase tracking-widest text-slate-400 mb-6">
        Trusted by Residents at Leading Institutions
      </p>
      <div class="flex flex-wrap items-center justify-center gap-x-10 gap-y-6">
        {institutions.map(b => (
          <div class="flex items-center gap-2.5 text-slate-500">
            <Icon name={b.icon} class="w-6 h-6 text-sky-600" />
            <div class="leading-tight">
              <div class="text-sm font-bold text-slate-700">{b.label}</div>
              <div class="text-[11px] text-slate-400">{b.sub}</div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {TESTIMONIALS.map(t => (
        <figure
          class="relative rounded-2xl border border-slate-200 bg-white p-6 hover:shadow-md transition-shadow"
          itemscope
          itemtype="https://schema.org/Review"
        >
          <meta itemprop="reviewRating" content="5" />
          <div class="flex items-center gap-1 mb-4" aria-label="5 out of 5 stars">
            {[1,2,3,4,5].map(() => (
              <Icon name="star" class="w-4 h-4 text-amber-400" />
            ))}
          </div>
          <blockquote class="text-sm text-slate-700 leading-relaxed mb-5 italic" itemprop="reviewBody">"{t.text}"</blockquote>
          <figcaption class="flex items-center gap-3 pt-4 border-t border-slate-100" itemprop="author" itemscope itemtype="https://schema.org/Person">
            <div class="h-10 w-10 rounded-full bg-sky-100 flex items-center justify-center text-sky-700 font-bold text-sm">
              {t.name.charAt(0)}
            </div>
            <div>
              <div class="text-sm font-semibold text-slate-900" itemprop="name">{t.name}</div>
              <div class="text-xs text-slate-500" itemprop="jobTitle">{t.role}</div>
            </div>
            <div class="ml-auto">
              <span class="inline-flex items-center rounded-full bg-sky-50 px-2 py-0.5 text-xs font-medium text-sky-700">
                {t.exam}
              </span>
            </div>
          </figcaption>
        </figure>
      ))}
    </div>

    <div class="mt-12 text-center">
      <a
        href="/success-stories"
        class="inline-flex items-center gap-2 text-sm font-semibold text-sky-600 hover:text-sky-700 transition-colors"
      >
        Read All Success Stories
        <Icon name="chevronRight" class="w-4 h-4" />
      </a>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(reviewLd)} />
</section>
