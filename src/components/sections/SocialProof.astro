---
import { TESTIMONIALS } from '../../config';
import Icon from '../Icon.astro';

const institutions = [
  { icon: 'building',   name: 'AIIMS',      sub: 'Trusted By Residents' },
  { icon: 'eye',        name: 'Aravind',    sub: 'Eye Hospital' },
  { icon: 'badgeCheck', name: 'LVPEI',      sub: 'Eye Institute' },
  { icon: 'globe',      name: 'Moorfields', sub: 'Eye Hospital UK' },
  { icon: 'heart',      name: 'Sankara',    sub: 'Nethralaya' },
];

// Duplicate enough cards for a smooth infinite loop on wide screens
const marqueeReviews = [...TESTIMONIALS, ...TESTIMONIALS, ...TESTIMONIALS];

const reviewLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'OphthaMCQ Ophthalmology Exam Preparation',
  description: 'Ophthalmology PG exam notes and MCQ question bank for ICO/FICO, FAICO, FRCOphth, DNB, MS, DO and PDCET.',
  brand: { '@type': 'Brand', name: 'OphthaMCQ' },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.8',
    reviewCount: '2400',
    bestRating: '5',
  },
  review: TESTIMONIALS.map(t => ({
    '@type': 'Review',
    reviewRating: { '@type': 'Rating', ratingValue: '5', bestRating: '5' },
    author: { '@type': 'Person', name: t.name, jobTitle: t.role },
    reviewBody: t.text,
  })),
};
---

<!-- Testimonials -->
<section class="section-skin-blue py-20 lg:py-28 overflow-hidden">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-12" data-reveal>
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-sky-700 mb-3">Social proof</p>
      <h2 class="font-display text-3xl sm:text-4xl font-semibold text-slate-900 tracking-tight">
        Ophthalmologists Who Passed. In Their Own Words.
      </h2>
    </div>

    <!-- Institutions -->
    <div class="mb-16">
      <p class="text-center text-sm sm:text-base font-semibold tracking-[0.15em] uppercase text-slate-400 mb-10">
        Trusted by Residents at Leading Institutions
      </p>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-x-6 gap-y-8 max-w-6xl mx-auto">
        {institutions.map(inst => (
          <div class="flex items-center gap-3 justify-center">
            <Icon name={inst.icon} class="w-9 h-9 lg:w-10 lg:h-10 text-sky-500 shrink-0" />
            <div class="text-left">
              <div class="text-base lg:text-lg font-bold text-slate-800 leading-tight">{inst.name}</div>
              <div class="text-xs lg:text-sm text-slate-500">{inst.sub}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Continuous RTL review marquee (full-bleed) -->
  <div class="review-marquee relative" data-reveal aria-label="Customer reviews scrolling continuously">
    <!-- Edge fades (match light blue section) -->
    <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-12 sm:w-24 bg-gradient-to-r from-sky-200 to-transparent" aria-hidden="true"></div>
    <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-12 sm:w-24 bg-gradient-to-l from-sky-300 to-transparent" aria-hidden="true"></div>

    <div class="review-marquee__track">
      <!-- Set A -->
      <div class="review-marquee__group">
        {marqueeReviews.map((t, i) => (
          <figure class="review-marquee__card">
            <span class="inline-flex items-center rounded-full bg-sky-50 border border-sky-200 px-2.5 py-0.5 text-xs font-semibold text-sky-700">
              {t.exam}
            </span>
            <div class="mt-3 flex items-center gap-1" aria-hidden="true">
              {[1, 2, 3, 4, 5].map(() => (
                <Icon name="star" class="w-3.5 h-3.5 text-amber-400" />
              ))}
            </div>
            <blockquote class="mt-3 text-sm text-slate-700 leading-relaxed italic line-clamp-4">
              “{t.text}”
            </blockquote>
            <figcaption class="mt-4 flex items-center gap-3 pt-3 border-t border-slate-100">
              <div class="h-9 w-9 rounded-full bg-sky-100 flex items-center justify-center text-sky-700 font-bold text-xs shrink-0">
                {t.name.charAt(4) || t.name.charAt(0)}
              </div>
              <div class="min-w-0">
                <div class="text-sm font-semibold text-slate-900 truncate">{t.name}</div>
                <div class="text-xs text-slate-500 truncate">{t.role}</div>
              </div>
            </figcaption>
          </figure>
        ))}
      </div>
      <!-- Set B (duplicate for seamless loop) -->
      <div class="review-marquee__group" aria-hidden="true">
        {marqueeReviews.map((t) => (
          <figure class="review-marquee__card">
            <span class="inline-flex items-center rounded-full bg-sky-50 border border-sky-200 px-2.5 py-0.5 text-xs font-semibold text-sky-700">
              {t.exam}
            </span>
            <div class="mt-3 flex items-center gap-1">
              {[1, 2, 3, 4, 5].map(() => (
                <Icon name="star" class="w-3.5 h-3.5 text-amber-400" />
              ))}
            </div>
            <blockquote class="mt-3 text-sm text-slate-700 leading-relaxed italic line-clamp-4">
              “{t.text}”
            </blockquote>
            <figcaption class="mt-4 flex items-center gap-3 pt-3 border-t border-slate-100">
              <div class="h-9 w-9 rounded-full bg-sky-100 flex items-center justify-center text-sky-700 font-bold text-xs shrink-0">
                {t.name.charAt(4) || t.name.charAt(0)}
              </div>
              <div class="min-w-0">
                <div class="text-sm font-semibold text-slate-900 truncate">{t.name}</div>
                <div class="text-xs text-slate-500 truncate">{t.role}</div>
              </div>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mt-12 text-center">
      <a
        href="/success-stories"
        class="inline-flex items-center gap-2 rounded-xl bg-white px-6 py-3 text-sm font-semibold text-slate-700 border-2 border-slate-200 hover:border-sky-300 hover:text-sky-700 transition-all"
      >
        Read All Success Stories
        <Icon name="chevronRight" class="w-4 h-4" />
      </a>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(reviewLd)} />
</section>

<style>
  .review-marquee {
    --marquee-gap: 1.25rem;
    --marquee-duration: 45s;
    position: relative;
    width: 100%;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
  }

  .review-marquee__track {
    display: flex;
    width: max-content;
    gap: var(--marquee-gap);
    animation: review-marquee-rtl var(--marquee-duration) linear infinite;
    will-change: transform;
  }

  .review-marquee:hover .review-marquee__track {
    animation-play-state: paused;
  }

  .review-marquee__group {
    display: flex;
    flex-shrink: 0;
    gap: var(--marquee-gap);
  }

  .review-marquee__card {
    flex: 0 0 auto;
    width: min(320px, 78vw);
    border-radius: 1rem;
    border: 1px solid #e2e8f0;
    background: #fff;
    padding: 1.25rem 1.35rem;
    box-shadow: 0 1px 2px rgb(15 23 42 / 0.04), 0 8px 20px rgb(15 23 42 / 0.04);
    transition: box-shadow 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
  }

  .review-marquee__card:hover {
    border-color: rgb(125 211 252 / 0.8);
    box-shadow: 0 4px 12px rgb(15 23 42 / 0.06), 0 16px 32px rgb(14 165 233 / 0.1);
    transform: translateY(-2px);
  }

  /* Right → left continuous loop (two identical groups) */
  @keyframes review-marquee-rtl {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(calc(-50% - var(--marquee-gap) / 2), 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .review-marquee__track {
      animation: none;
      flex-wrap: wrap;
      width: 100%;
      max-width: 80rem;
      margin-inline: auto;
      justify-content: center;
      padding-inline: 1rem;
      gap: 1rem;
    }

    .review-marquee__group:last-child {
      display: none;
    }

    .review-marquee__group {
      flex-wrap: wrap;
      justify-content: center;
    }
  }
</style>
