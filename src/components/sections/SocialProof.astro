---
import { TESTIMONIALS } from '../../config';
import Icon from '../Icon.astro';
---

<section class="bg-white py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 tracking-tight">
        Trusted by 15,000+ Ophthalmology Residents
      </h2>
      <p class="mt-4 text-lg text-slate-600">
        Real doctors. Real results. Real exam passes.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {TESTIMONIALS.map(t => (
        <div class="relative rounded-2xl border border-slate-200 bg-white p-6 hover:shadow-md transition-shadow">
          <div class="flex items-center gap-1 mb-4">
            {[1,2,3,4,5].map(() => (
              <Icon name="star" class="w-4 h-4 text-amber-400" />
            ))}
          </div>
          <p class="text-sm text-slate-700 leading-relaxed mb-5 italic">"{t.text}"</p>
          <div class="flex items-center gap-3 pt-4 border-t border-slate-100">
            <div class="h-10 w-10 rounded-full bg-sky-100 flex items-center justify-center text-sky-700 font-bold text-sm">
              {t.name.charAt(0)}
            </div>
            <div>
              <div class="text-sm font-semibold text-slate-900">{t.name}</div>
              <div class="text-xs text-slate-500">{t.role}</div>
            </div>
            <div class="ml-auto">
              <span class="inline-flex items-center rounded-full bg-sky-50 px-2 py-0.5 text-xs font-medium text-sky-700">
                {t.exam}
              </span>
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-12 text-center">
      <a
        href="/success-stories"
        class="inline-flex items-center gap-2 text-sm font-semibold text-sky-600 hover:text-sky-700 transition-colors"
      >
        Read All Success Stories
        <Icon name="chevronRight" class="w-4 h-4" />
      </a>
    </div>
  </div>
</section>