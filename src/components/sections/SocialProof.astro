---
import { TESTIMONIALS } from '../../config';
import Icon from '../Icon.astro';

const institutions = [
  { icon: 'building',   name: 'AIIMS',      sub: 'Trusted By Residents' },
  { icon: 'eye',        name: 'Aravind',    sub: 'Eye Hospital' },
  { icon: 'badgeCheck', name: 'LVPEI',      sub: 'Eye Institute' },
  { icon: 'globe',      name: 'Moorfields', sub: 'Eye Hospital UK' },
  { icon: 'heart',      name: 'Sankara',    sub: 'Nethralaya' },
];

const reviewLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'OphthaMCQ Ophthalmology Exam Preparation',
  description: 'Ophthalmology PG exam notes and MCQ question bank for ICO/FICO, FAICO, FRCOphth, DNB, MS, DO and PDCET.',
  brand: { '@type': 'Brand', name: 'OphthaMCQ' },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.8',
    reviewCount: '2400',
    bestRating: '5',
  },
  review: TESTIMONIALS.map(t => ({
    '@type': 'Review',
    reviewRating: { '@type': 'Rating', ratingValue: '5', bestRating: '5' },
    author: { '@type': 'Person', name: t.name, jobTitle: t.role },
    reviewBody: t.text,
  })),
};
---

<!-- Testimonials -->
<section class="bg-white py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 tracking-tight">
        Ophthalmologists Who Passed. In Their Own Words.
      </h2>
    </div>

    <!-- Institutions -->
    <div class="mb-16">
      <p class="text-center text-sm sm:text-base font-semibold tracking-[0.15em] uppercase text-slate-400 mb-10">
        Trusted by Residents at Leading Institutions
      </p>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-x-6 gap-y-8 max-w-6xl mx-auto">
        {institutions.map(inst => (
          <div class="flex items-center gap-3 justify-center">
            <Icon name={inst.icon} class="w-9 h-9 lg:w-10 lg:h-10 text-sky-500 shrink-0" />
            <div class="text-left">
              <div class="text-base lg:text-lg font-bold text-slate-800 leading-tight">{inst.name}</div>
              <div class="text-xs lg:text-sm text-slate-500">{inst.sub}</div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Row 1: 3 cards -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mb-6">
      {TESTIMONIALS.slice(0, 3).map(t => (
        <figure
          class="relative rounded-2xl border border-slate-200 bg-white p-6 hover:shadow-md transition-shadow"
          itemscope
          itemtype="https://schema.org/Review"
        >
          <meta itemprop="reviewRating" content="5" />
          <span class="absolute top-5 left-5 inline-flex items-center rounded-full bg-sky-50 border border-sky-200 px-2.5 py-0.5 text-xs font-semibold text-sky-700">
            {t.exam}
          </span>
          <div class="mt-10 flex items-center gap-1 mb-3" aria-label="5 out of 5 stars">
            {[1,2,3,4,5].map(() => (
              <Icon name="star" class="w-4 h-4 text-amber-400" />
            ))}
          </div>
          <blockquote class="text-sm text-slate-700 leading-relaxed mb-5 italic" itemprop="reviewBody">"{t.text}"</blockquote>
          <figcaption class="flex items-center gap-3 pt-4 border-t border-slate-100" itemprop="author" itemscope itemtype="https://schema.org/Person">
            <div class="h-10 w-10 rounded-full bg-sky-100 flex items-center justify-center text-sky-700 font-bold text-sm">
              {t.name.charAt(4) || t.name.charAt(0)}
            </div>
            <div>
              <div class="text-sm font-semibold text-slate-900" itemprop="name">{t.name}</div>
              <div class="text-xs text-slate-500" itemprop="jobTitle">{t.role}</div>
            </div>
          </figcaption>
        </figure>
      ))}
    </div>

    <!-- Row 2: 2 cards centered -->
    <div class="grid md:grid-cols-2 gap-6 max-w-4xl mx-auto">
      {TESTIMONIALS.slice(3, 5).map(t => (
        <figure
          class="relative rounded-2xl border border-slate-200 bg-white p-6 hover:shadow-md transition-shadow"
          itemscope
          itemtype="https://schema.org/Review"
        >
          <meta itemprop="reviewRating" content="5" />
          <span class="absolute top-5 left-5 inline-flex items-center rounded-full bg-sky-50 border border-sky-200 px-2.5 py-0.5 text-xs font-semibold text-sky-700">
            {t.exam}
          </span>
          <div class="mt-10 flex items-center gap-1 mb-3" aria-label="5 out of 5 stars">
            {[1,2,3,4,5].map(() => (
              <Icon name="star" class="w-4 h-4 text-amber-400" />
            ))}
          </div>
          <blockquote class="text-sm text-slate-700 leading-relaxed mb-5 italic" itemprop="reviewBody">"{t.text}"</blockquote>
          <figcaption class="flex items-center gap-3 pt-4 border-t border-slate-100" itemprop="author" itemscope itemtype="https://schema.org/Person">
            <div class="h-10 w-10 rounded-full bg-sky-100 flex items-center justify-center text-sky-700 font-bold text-sm">
              {t.name.charAt(4) || t.name.charAt(0)}
            </div>
            <div>
              <div class="text-sm font-semibold text-slate-900" itemprop="name">{t.name}</div>
              <div class="text-xs text-slate-500" itemprop="jobTitle">{t.role}</div>
            </div>
          </figcaption>
        </figure>
      ))}
    </div>

    <div class="mt-12 text-center">
      <a
        href="/success-stories"
        class="inline-flex items-center gap-2 rounded-xl bg-white px-6 py-3 text-sm font-semibold text-slate-700 border-2 border-slate-200 hover:border-sky-300 hover:text-sky-700 transition-all"
      >
        Read All Success Stories
        <Icon name="chevronRight" class="w-4 h-4" />
      </a>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(reviewLd)} />
</section>
