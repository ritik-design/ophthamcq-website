---
import Icon from '../Icon.astro';

const steps = [
  { num: '01', title: 'Sign Up Free', desc: 'Start with 50 free MCQs across all subspecialties. No credit card, no signup hassle.', icon: 'user' },
  { num: '02', title: 'Practice Smart', desc: 'Timed quizzes, instant explanations, and performance tracking by topic. Find your weak spots.', icon: 'mcq' },
  { num: '03', title: 'Track & Pass', desc: 'Watch your percentile climb. Walk into the exam hall with confidence. 87% pass on first attempt.', icon: 'trophy' },
];
---

<section class="bg-white py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 tracking-tight">
        Pass Your Exam in 3 Steps
      </h2>
      <p class="mt-4 text-lg text-slate-600">
        No 900-page textbooks. No scattered notes. Just exactly what you need.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8 relative">
      <div class="hidden md:block absolute top-12 left-[16.67%] right-[16.67%] h-0.5 bg-sky-100"></div>

      {steps.map(s => (
        <div class="relative text-center">
          <div class="relative z-10 mx-auto mb-6 flex h-24 w-24 items-center justify-center rounded-full bg-sky-50 border-4 border-white shadow-lg">
            <Icon name={s.icon} class="w-8 h-8 text-sky-600" />
          </div>
          <div class="inline-flex items-center justify-center rounded-full bg-sky-600 px-3 py-1 text-xs font-bold text-white mb-4">
            Step {s.num}
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-2">{s.title}</h3>
          <p class="text-sm text-slate-600 leading-relaxed max-w-xs mx-auto">{s.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>