---
import Icon from '../Icon.astro';

const stats = [
  { value: '4.8', label: 'Rating', star: true },
  { value: '15,000+', label: 'PGs' },
  { value: '20,000+', label: 'MCQs' },
  { value: '87%', label: 'Pass Rate' },
  { value: '23', label: 'Countries' },
];
---

<section class="section-skin-clean relative border-y border-slate-200/80" data-reveal>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-7 lg:py-8">
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-y-6 gap-x-4 items-center" data-stagger>
      {stats.map(s => (
        <div class="flex flex-col items-center text-center group">
          <div class="flex items-center gap-1.5">
            {s.star && (
              <Icon name="star" class="w-5 h-5 text-amber-400 drop-shadow-sm transition-transform duration-300 group-hover:scale-110" />
            )}
            <span class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight tabular-nums">
              {s.value}
            </span>
          </div>
          <span class="mt-1 text-xs sm:text-sm text-slate-500 font-medium tracking-wide uppercase">
            {s.label}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>
