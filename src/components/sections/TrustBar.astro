---
import Icon from '../Icon.astro';

const stats = [
  { value: '4.8', label: 'Rating', star: true },
  { value: '15,000+', label: 'PGs' },
  { value: '20,000+', label: 'MCQs' },
  { value: '87%', label: 'Pass Rate' },
  { value: '23', label: 'Countries' },
];
---

<section class="bg-slate-50 border-y border-slate-200">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-6 lg:py-7">
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-y-4 gap-x-4 items-center">
      {stats.map(s => (
        <div class="flex flex-col items-center text-center">
          <div class="flex items-center gap-1.5">
            {s.star && <Icon name="star" class="w-5 h-5 text-amber-400" />}
            <span class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">{s.value}</span>
          </div>
          <span class="mt-0.5 text-xs sm:text-sm text-slate-500 font-medium">{s.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>
