---
import { PRODUCTS } from '../../config';
import Icon from '../Icon.astro';

// Hero product: the flagship Exam Ready Handwritten Notes line.
// Pull the strongest in-line product (Retina Deciphered) for the visual and
// also link to the full notes catalogue for browsing the rest of the lineup.
const flagship = PRODUCTS.find(p => p.id === 'retina-deciphered') ?? PRODUCTS[0];
const notesLineup = PRODUCTS.filter(p => p.category === 'notes');
---

<section class="relative bg-gradient-to-br from-amber-50 via-white to-sky-50 py-20 lg:py-28 overflow-hidden">
  <div class="absolute inset-0 opacity-[0.05]" aria-hidden="true">
    <svg width="100%" height="100%">
      <defs>
        <pattern id="dots" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="currentColor"/>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#dots)"/>
    </svg>
  </div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <div>
        <div class="inline-flex items-center gap-2 rounded-full bg-amber-100 border border-amber-200 px-3 py-1 mb-5">
          <Icon name="star" class="w-4 h-4 text-amber-600" />
          <span class="text-xs font-bold uppercase tracking-wide text-amber-800">Hero Product</span>
        </div>

        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
          Exam Ready Ophthalmology Notes
          <span class="block text-sky-600 mt-1">for Postgraduates &amp; Residency</span>
        </h2>
        <p class="mt-3 text-base sm:text-lg font-semibold text-slate-500 uppercase tracking-wider">
          100% Handwritten
        </p>

        <p class="mt-6 text-lg text-slate-700 leading-relaxed max-w-xl">
          The notes you wish your seniors had handed you on day one. Every page is
          handwritten by ophthalmologists who passed FRCOphth, DNB, ICO and FAICO —
          distilling Kanski, Ryan and BCSC into the bullet points that actually appear
          in the exam.
        </p>

        <ul class="mt-7 space-y-3">
          {[
            'Topic-wise: Retina, Glaucoma, Cornea, Optics, Anatomy, Eyelids & more',
            'Designed for fast revision in the final 30 days before your exam',
            'Lifetime PDF access + sync to iOS &amp; Android app',
            'Distilled from Kanski, Ryan, Elkington, BCSC and AAO guidelines',
          ].map(item => (
            <li class="flex items-start gap-3 text-slate-700">
              <span class="shrink-0 mt-1 w-5 h-5 rounded-full bg-emerald-100 inline-flex items-center justify-center">
                <Icon name="check" class="w-3.5 h-3.5 text-emerald-700" />
              </span>
              <span set:html={item} />
            </li>
          ))}
        </ul>

        <div class="mt-9 flex flex-col sm:flex-row gap-4">
          <a
            href="/notes"
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-sky-600 px-7 py-4 text-base font-semibold text-white shadow-lg shadow-sky-200 hover:bg-sky-700 transition-colors"
          >
            Explore Products
            <Icon name="arrowRight" class="w-5 h-5" />
          </a>
          <a
            href={flagship.href}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-white px-7 py-4 text-base font-semibold text-slate-700 border-2 border-slate-200 hover:border-sky-300 hover:text-sky-700 transition-colors"
          >
            View on Store
            <Icon name="externalLink" class="w-4 h-4" />
          </a>
        </div>

        <p class="mt-4 text-sm text-slate-500">
          {notesLineup.length} note titles available · Lifetime access on web, iOS &amp; Android
        </p>
      </div>

      <div class="relative">
        <div class="relative grid grid-cols-2 gap-4">
          {notesLineup.slice(0, 4).map((p, i) => (
            <a
              href={`/products/${p.id}`}
              class={`group relative rounded-2xl overflow-hidden bg-white shadow-lg ring-1 ring-slate-200 hover:ring-sky-300 transition-all ${i % 2 === 0 ? 'translate-y-4' : ''}`}
            >
              <div class="aspect-[3/4] bg-slate-100 overflow-hidden">
                <img
                  src={p.image}
                  alt={p.fullName}
                  loading="lazy"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                />
              </div>
              <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-slate-900/90 via-slate-900/40 to-transparent p-4">
                <p class="text-xs font-semibold text-white/90 uppercase tracking-wider truncate">{p.name}</p>
                <p class="text-base font-bold text-white mt-0.5">{p.price}</p>
              </div>
            </a>
          ))}
        </div>

        <div class="absolute -top-6 -right-4 rotate-6 inline-flex items-center gap-2 rounded-xl bg-amber-400 px-4 py-2 shadow-lg ring-2 ring-white">
          <Icon name="check" class="w-4 h-4 text-amber-900" />
          <span class="text-xs font-bold text-amber-900 uppercase tracking-wider">Trusted by 15,000+ residents</span>
        </div>
      </div>
    </div>
  </div>
</section>
