---
import Icon from '../Icon.astro';
---

<section class="relative overflow-hidden bg-sky-900 py-20 lg:py-28">
  <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
    <div class="absolute -top-24 -right-24 w-96 h-96 rounded-full bg-sky-800/50"></div>
    <div class="absolute -bottom-24 -left-24 w-80 h-80 rounded-full bg-sky-800/50"></div>
  </div>

  <div class="relative mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight">
      Your Exam Is Coming.<br />
      <span class="text-sky-300">Are You Ready?</span>
    </h2>
    <p class="mt-6 text-lg text-sky-100 max-w-2xl mx-auto">
      Join 15,000+ residents who passed their exams with OphthaMCQ.
      Start with 50 free MCQs today.
    </p>

    <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href="/free-mcqs"
        class="w-full sm:w-auto inline-flex items-center justify-center rounded-xl bg-white px-8 py-4 text-base font-semibold text-sky-900 shadow-lg hover:bg-sky-50 transition-colors"
      >
        Start Free Practice
        <Icon name="arrowRight" class="ml-2 h-5 w-5" />
      </a>
      <a
        href="/exams"
        class="w-full sm:w-auto inline-flex items-center justify-center rounded-xl bg-sky-700 px-8 py-4 text-base font-semibold text-white border-2 border-sky-500 hover:bg-sky-600 transition-colors"
      >
        Explore Exams
      </a>
    </div>

    <p class="mt-4 text-sm text-sky-200">
      No credit card required for free practice. All purchases handled securely on ophthamcq.com.
    </p>
  </div>
</section>