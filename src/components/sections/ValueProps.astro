---
import Illustration from '../Illustration.astro';

const props = [
  {
    illustration: 'notes',
    title: 'Exam-Ready Notes',
    desc: "The world's only handwritten notes distilled from Ryan, Kanski & Elkington into exam-ready bullet points.",
    highlight: '150+ pages per topic',
  },
  {
    illustration: 'pastPapers',
    title: 'Real Past Papers',
    desc: 'ICO/FICO past papers with full explanations — your single biggest advantage going into the exam hall.',
    highlight: 'Last 10 years covered',
  },
  {
    illustration: 'imageMcq',
    title: 'Image-Based MCQs',
    desc: 'Visual learning with fundus photos, OCTs, and slit-lamp images. Master what the exam actually shows.',
    highlight: '500+ clinical images',
  },
  {
    illustration: 'mobile',
    title: 'Study Anywhere',
    desc: 'Native iOS and Android apps. Practice MCQs during clinic breaks, commutes, or late-night revision.',
    highlight: 'Offline mode included',
  },
];
---

<section class="bg-white py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 tracking-tight">
        Everything You Need to Pass
      </h2>
      <p class="mt-4 text-lg text-slate-600">
        Not another generic question bank. Built by ophthalmologists who sat these exact exams.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8">
      {props.map(p => (
        <div class="group relative rounded-2xl border border-slate-200 bg-white p-6 hover:shadow-lg hover:border-sky-200 transition-all duration-300">
          <div class="w-16 h-16 rounded-xl bg-sky-50 flex items-center justify-center mb-4">
            <Illustration name={p.illustration} class="w-12 h-12" />
          </div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">{p.title}</h3>
          <p class="text-sm text-slate-600 leading-relaxed mb-4">{p.desc}</p>
          <div class="inline-flex items-center rounded-full bg-sky-50 px-3 py-1 text-xs font-semibold text-sky-700">
            {p.highlight}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>