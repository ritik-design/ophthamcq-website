---
import Icon from '../Icon.astro';

const cards = [
  {
    id: 'A',
    icon: 'badgeCheck',
    title: 'Built by Ophthalmologists Who Passed',
    body: 'Built by ophthalmologists who personally passed ICO, FAICO, DNB and FRCOphth — not generic medical content writers.',
  },
  {
    id: 'B',
    icon: 'target',
    title: 'The Only FAICO-Specific MCQ Bank',
    body: 'The only MCQ bank mapped subspecialty-wise to the exact AIOS FAICO syllabus.',
  },
  {
    id: 'C1',
    icon: 'notes',
    title: 'Exam Ready PG & Residency Handwritten Notes',
    body: 'Written by gold medalists and exam toppers — ophthalmologists who topped their MS, DNB and fellowship exams. Not generic content writers. They know exactly what examiners look for and what never appears in the exam.',
    prominent: true,
  },
  {
    id: 'C2',
    icon: 'pastPapers',
    title: "Distilled From the World's Standard Textbooks",
    body: 'Retina Deciphered, Glaucoma Exam Ready Notes, Optics & Refraction, Anatomy of Eye, Uveitis Simplified — every note distilled from Ryan, Kanski, Elkington, BCSC and Khurana into concise exam-ready bullet points. No fluff. No copy-paste. Just what the exam tests.',
  },
  {
    id: 'D',
    icon: 'globe',
    title: "World's First & Only",
    body: 'ICO/FICO past papers with full explanations — first time in the world. Not available anywhere else on the planet.',
    badge: "World's First",
    highlight: true,
  },
  {
    id: 'E',
    icon: 'building',
    title: 'Every Major Ophthalmology PG Exam. One Platform.',
    body: 'ICO/FICO, FAICO, DNB/MS/DO, PDCET — all covered under one platform. No need to look anywhere else.',
  },
  {
    id: 'F',
    icon: 'mobile',
    title: 'Built for Busy Residents',
    body: 'Concise, exam-focused and accessible on Android and iOS anytime. Practice during clinic breaks, commutes or late-night revision.',
  },
  {
    id: 'G',
    icon: 'star',
    title: '87% Pass Rate. 23 Countries.',
    body: '15,000+ ophthalmology PGs and residents across 23 countries trust OphthaMCQ to pass on the first attempt.',
  },
  {
    id: 'H',
    icon: 'check',
    title: 'Complete Practical Exam Prep',
    body: 'The only platform with OSCE stations, instruments, case presentation format and viva voce prep for DNB/MS/DO.',
  },
];
---

<section class="section-skin-clean py-20 lg:py-28" data-reveal>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-14">
      <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 tracking-tight">
        Why 15,000+ Ophthalmologists Trust OphthaMCQ
      </h2>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {cards.map(c => (
        <div class:list={[
          'relative rounded-2xl bg-white p-6 transition-all',
          c.highlight
            ? 'border-2 border-sky-500 shadow-lg shadow-sky-100 ring-1 ring-sky-200'
            : c.prominent
              ? 'border border-sky-200 shadow-sm hover:shadow-md'
              : 'border border-slate-200 hover:border-sky-300 hover:shadow-md',
        ]}>
          {c.badge && (
            <span class="absolute -top-3 left-6 inline-flex items-center rounded-full bg-sky-600 px-3 py-1 text-[10px] font-bold uppercase tracking-widest text-white shadow-sm">
              {c.badge}
            </span>
          )}
          <div class:list={[
            'w-12 h-12 rounded-xl flex items-center justify-center mb-4',
            c.highlight ? 'bg-sky-100' : 'bg-sky-50',
          ]}>
            <Icon name={c.icon} class={`w-6 h-6 ${c.highlight ? 'text-sky-700' : 'text-sky-600'}`} />
          </div>
          <h3 class="text-base font-bold text-slate-900 leading-snug mb-2">{c.title}</h3>
          <p class="text-sm text-slate-600 leading-relaxed">{c.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
