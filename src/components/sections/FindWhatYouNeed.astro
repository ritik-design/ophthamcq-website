---
import Icon from '../Icon.astro';

const examCards = [
  { name: 'ICO / FICO',     sub: 'International Council of Ophthalmology',        href: '/exams/ico-fico',  icon: 'globe' },
  { name: 'FAICO',          sub: 'Fellowship of All India Ophthalmological Society', href: '/exams/faico',     icon: 'badgeCheck' },
  { name: 'DNB / MS / DO',  sub: 'Diplomate of National Board',                   href: '/exams/dnb',       icon: 'building' },
  { name: 'PDCET',          sub: 'Post Diploma Centralized Entrance Test',        href: '/exams/pd-cet',    icon: 'target' },
  { name: 'FRCOphth',       sub: 'Royal College of Ophthalmologists',             href: '/exams/frcophth',  icon: 'graduationCap', badge: 'Coming Soon' },
  { name: 'Fellowship',     sub: 'Ophthalmology Subspecialty Fellowship',         href: '/exams/fellowship', icon: 'sparkles' },
];

const productCards = [
  {
    title: 'Handwritten Exam Ready Notes',
    sub: "The world's only ophthalmology PG, residency and resident exam ready handwritten notes",
    href: '/notes',
    icon: 'notes',
    badge: 'Most Popular',
  },
  {
    title: 'MCQ Question Banks',
    sub: '20,000+ exam-pattern MCQs across all subspecialties',
    href: '/exams',
    icon: 'questionBank',
  },
  {
    title: 'Past Papers',
    sub: 'ICO/FICO past papers with full explanations',
    href: '/exams/ico-fico',
    icon: 'pastPapers',
  },
  {
    title: 'OSCE, Practical & Viva Voce Ready',
    sub: 'Complete DNB/MS/DO practical exam bundle — OSCE stations, instruments, case presentation, investigations and viva voce prep',
    href: '/osce',
    icon: 'check',
    badge: 'New Launch',
  },
];
---

<section class="bg-white py-20 lg:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-14">
      <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 tracking-tight">
        Find What You Need
      </h2>
      <p class="mt-4 text-lg text-slate-600">
        Pick your exam or jump straight to the product type you want.
      </p>
    </div>

    <div class="mb-16">
      <h3 class="text-sm font-semibold uppercase tracking-widest text-slate-500 mb-6">Browse by Exam</h3>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {examCards.map(c => (
          <a
            href={c.href}
            class:list={[
              'group relative flex items-start gap-4 rounded-2xl border border-slate-200 bg-white p-5 hover:border-sky-300 hover:shadow-md transition-all',
              c.badge === 'Coming Soon' && 'opacity-75',
            ]}
          >
            <div class="w-11 h-11 rounded-xl bg-sky-50 flex items-center justify-center shrink-0">
              <Icon name={c.icon} class="w-5 h-5 text-sky-600" />
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <h4 class="text-base font-bold text-slate-900">{c.name}</h4>
                {c.badge && (
                  <span class="inline-flex items-center rounded-full bg-amber-50 border border-amber-200 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-amber-700">
                    {c.badge}
                  </span>
                )}
              </div>
              <p class="mt-1 text-sm text-slate-600 leading-snug">{c.sub}</p>
            </div>
            <Icon name="chevronRight" class="w-4 h-4 text-slate-400 group-hover:text-sky-600 group-hover:translate-x-0.5 transition-all shrink-0 mt-1" />
          </a>
        ))}
      </div>
    </div>

    <div>
      <h3 class="text-sm font-semibold uppercase tracking-widest text-slate-500 mb-6">Browse by Product</h3>
      <div class="grid sm:grid-cols-2 gap-5">
        {productCards.map(c => (
          <a
            href={c.href}
            class="group relative flex items-start gap-4 rounded-2xl border border-slate-200 bg-white p-6 hover:border-sky-300 hover:shadow-md transition-all"
          >
            <div class="w-11 h-11 rounded-xl bg-sky-50 flex items-center justify-center shrink-0">
              <Icon name={c.icon} class="w-5 h-5 text-sky-600" />
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 flex-wrap mb-1">
                <h4 class="text-base font-bold text-slate-900">{c.title}</h4>
                {c.badge && (
                  <span class:list={[
                    'inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide border',
                    c.badge === 'Most Popular' ? 'bg-sky-50 border-sky-200 text-sky-700' : 'bg-emerald-50 border-emerald-200 text-emerald-700',
                  ]}>
                    {c.badge}
                  </span>
                )}
              </div>
              <p class="text-sm text-slate-600 leading-snug">{c.sub}</p>
            </div>
            <Icon name="chevronRight" class="w-4 h-4 text-slate-400 group-hover:text-sky-600 group-hover:translate-x-0.5 transition-all shrink-0 mt-1" />
          </a>
        ))}
      </div>
    </div>
  </div>
</section>
