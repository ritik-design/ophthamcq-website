---
import Icon from '../Icon.astro';

const examCards = [
  { name: 'ICO / FICO',     sub: 'International Council of Ophthalmology',           href: '/exams/ico-fico/',  icon: 'globe' },
  { name: 'FAICO',          sub: 'Fellowship of All India Ophthalmological Society', href: '/exams/faico/',     icon: 'badgeCheck' },
  { name: 'DNB / MS / DO',  sub: 'Diplomate of National Board',                      href: '/exams/dnb/',       icon: 'building' },
  { name: 'PDCET',          sub: 'Post Diploma Centralized Entrance Test',           href: '/exams/pd-cet/',    icon: 'target' },
  { name: 'FRCOphth',       sub: 'Royal College of Ophthalmologists',                href: '/exams/frcophth/',  icon: 'graduationCap', badge: 'Coming Soon' },
  { name: 'Fellowship',     sub: 'Ophthalmology Subspecialty Fellowship',            href: '/exams/fellowship/', icon: 'sparkles' },
];

const productCards = [
  {
    title: 'Handwritten Exam Ready Notes',
    sub: "The world's only ophthalmology PG, residency and resident exam ready handwritten notes",
    href: '/notes/',
    icon: 'notes',
    badge: 'Most Popular',
  },
  {
    title: 'MCQ Question Banks',
    sub: '20,000+ exam-pattern MCQs across all subspecialties',
    href: '/exams/',
    icon: 'questionBank',
  },
  {
    title: 'Past Papers',
    sub: 'ICO/FICO past papers with full explanations',
    href: '/exams/ico-fico/',
    icon: 'pastPapers',
  },
  {
    title: 'OSCE, Practical & Viva Voce Ready',
    sub: 'Complete DNB/MS/DO practical exam bundle — OSCE stations, instruments, case presentation, investigations and viva voce prep',
    href: '/osce/',
    icon: 'check',
    badge: 'New Launch',
  },
];
---

<section class="section-skin-blue py-20 lg:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-14" data-reveal>
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-sky-700 mb-3">Navigate</p>
      <h2 class="font-display text-3xl sm:text-4xl font-semibold text-slate-900 tracking-tight">
        Find What You Need
      </h2>
      <p class="mt-4 text-lg text-slate-600">
        Pick your exam or jump straight to the product type you want.
      </p>
    </div>

    <!-- Row 1: Browse by Exam — 6 cards across on desktop -->
    <div class="mb-16">
      <h3 class="text-sm font-semibold uppercase tracking-widest text-slate-500 mb-6 text-center">Browse by Exam</h3>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4" data-stagger>
        {examCards.map(c => (
          <a
            href={c.href}
            class:list={[
              'group relative flex flex-col items-center text-center rounded-2xl border border-slate-200 bg-white p-5 hover:border-sky-300 hover:shadow-md transition-all',
              c.badge === 'Coming Soon' && 'opacity-75',
            ]}
          >
            {c.badge && (
              <span class="absolute top-2 right-2 inline-flex items-center rounded-full bg-slate-100 border border-slate-200 px-2 py-0.5 text-[9px] font-semibold uppercase tracking-wide text-slate-600">
                {c.badge}
              </span>
            )}
            <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-sky-50 to-cyan-50 ring-1 ring-sky-100 flex items-center justify-center mb-3 transition-transform duration-300 group-hover:scale-110">
              <Icon name={c.icon} class="w-6 h-6 text-sky-600" />
            </div>
            <h4 class="text-sm font-bold text-slate-900 leading-tight">{c.name}</h4>
            <p class="mt-1.5 text-xs text-slate-500 leading-snug">{c.sub}</p>
          </a>
        ))}
      </div>
    </div>

    <!-- Row 2: Browse by Product — 4 cards 2x2 mobile, 4 across desktop -->
    <div>
      <h3 class="text-sm font-semibold uppercase tracking-widest text-slate-500 mb-6 text-center">Browse by Product</h3>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5" data-stagger>
        {productCards.map(c => (
          <a
            href={c.href}
            class="group relative flex flex-col rounded-2xl border border-slate-200 bg-white p-6 hover:border-sky-300 hover:shadow-md transition-all"
          >
            {c.badge && (
              <span class:list={[
                'absolute top-3 right-3 inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide border',
                c.badge === 'Most Popular' ? 'bg-sky-50 border-sky-200 text-sky-700' : 'bg-emerald-50 border-emerald-200 text-emerald-700',
              ]}>
                {c.badge}
              </span>
            )}
            <div class="w-11 h-11 rounded-xl bg-sky-50 flex items-center justify-center mb-4">
              <Icon name={c.icon} class="w-5 h-5 text-sky-600" />
            </div>
            <h4 class="text-base font-bold text-slate-900 mb-2 leading-tight">{c.title}</h4>
            <p class="text-sm text-slate-600 leading-snug flex-1">{c.sub}</p>
            <span class="mt-4 inline-flex items-center text-sm font-semibold text-sky-700 group-hover:text-sky-800">
              Explore
              <Icon name="chevronRight" class="ml-1 w-4 h-4 group-hover:translate-x-0.5 transition-transform" />
            </span>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>
