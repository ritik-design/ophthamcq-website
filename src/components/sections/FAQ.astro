---
import { FAQS } from '../../config';
import Icon from '../Icon.astro';
---

<section class="bg-white py-20 lg:py-28">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 tracking-tight">
        Frequently Asked Questions
      </h2>
      <p class="mt-4 text-lg text-slate-600">
        Everything you need to know before you start.
      </p>
    </div>

    <div class="space-y-4">
      {FAQS.map(faq => (
        <details class="group rounded-xl border border-slate-200 bg-white open:shadow-sm transition-all">
          <summary class="flex cursor-pointer items-center justify-between p-5 text-left">
            <span class="text-base font-semibold text-slate-900 pr-4">{faq.q}</span>
            <span class="shrink-0 text-slate-400 group-open:rotate-180 transition-transform">
              <Icon name="chevronDown" class="w-5 h-5" />
            </span>
          </summary>
          <div class="px-5 pb-5 text-sm text-slate-600 leading-relaxed">
            {faq.a}
          </div>
        </details>
      ))}
    </div>

    <div class="mt-12 text-center p-6 rounded-2xl bg-sky-50 border border-sky-100">
      <p class="text-slate-700 mb-3">Still have questions?</p>
      <a
        href="https://wa.me/919999999999"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-xl bg-emerald-500 px-6 py-2.5 text-sm font-semibold text-white hover:bg-emerald-600 transition-colors"
      >
        <Icon name="chat" class="w-5 h-5" />
        Chat on WhatsApp
      </a>
      <p class="mt-2 text-xs text-slate-500">Average response time: under 4 hours</p>
    </div>
  </div>
</section>