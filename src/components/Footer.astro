---
import { SITE, APP_LINKS } from '../config';
import Icon from './Icon.astro';

const examLinks = [
  { label: 'ICO / FICO',    href: '/exams/ico-fico' },
  { label: 'FAICO',         href: '/exams/faico' },
  { label: 'DNB / MS / DO', href: '/exams/dnb' },
  { label: 'PDCET',         href: '/exams/pd-cet' },
  { label: 'FRCOphth',      href: '/exams/frcophth', comingSoon: true },
  { label: 'Fellowship',    href: '/exams/fellowship' },
];

const productLinks = [
  { label: 'Handwritten Exam Ready Notes', href: '/notes' },
  { label: 'MCQ Question Banks',           href: '/exams' },
  { label: 'ICO/FICO Past Papers',         href: '/exams/ico-fico' },
  { label: 'FAICO MCQs',                   href: '/exams/faico' },
  { label: 'OSCE & Practical Prep',        href: '/osce' },
  { label: 'High Yield MCQs',              href: '/exams' },
];

const resourceLinks = [
  { label: 'Blog',                  href: '/blog' },
  { label: 'Free Sample Questions', href: '/free-mcqs' },
  { label: 'Glossary',              href: '/glossary' },
  { label: 'Success Stories',       href: '/success-stories' },
  { label: 'FAQ',                   href: '/faq' },
  { label: 'Free Resources',        href: '/resources' },
];

const companyLinks = [
  { label: 'About Us',             href: '/about' },
  { label: 'Contact',              href: '/contact' },
  { label: 'Institutional Sales',  href: '/institutions' },
  { label: 'Help & Support',       href: '/faq' },
  { label: 'Pricing & Refunds',    href: '/faq#pricing-refunds' },
];
---

<footer class="relative bg-slate-950 text-slate-300 overflow-hidden">
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_60%_40%_at_50%_0%,rgba(14,165,233,0.12),transparent)]" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-14 lg:py-16">
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-10 lg:gap-12">
      <!-- Column 1 — Brand -->
      <div class="col-span-2 md:col-span-3 lg:col-span-1">
        <a href="/" class="flex items-center gap-2 mb-4 group">
          <img src="/logo.png" alt="OphthaMCQ" class="w-9 h-9 object-contain bg-white rounded-lg p-1 transition-transform duration-300 group-hover:scale-105" />
          <span class="text-lg font-bold text-white tracking-tight">{SITE.name}</span>
        </a>
        <p class="text-sm text-slate-400 leading-relaxed mb-2">
          The world's only ophthalmology PG exam notes and MCQ question bank.
        </p>
        <p class="text-sm text-slate-500 italic mb-5">
          By Ophthalmologists. For Ophthalmologists.
        </p>

        <div class="flex flex-col gap-2 mb-5">
          <a
            href={APP_LINKS.googlePlay}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-lg border border-slate-700 px-3 py-2 text-xs font-semibold text-white hover:border-slate-500 transition-colors"
          >
            <Icon name="mobile" class="w-4 h-4" />
            <span>Get it on Google Play</span>
          </a>
          <a
            href={APP_LINKS.appStore}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-lg border border-slate-700 px-3 py-2 text-xs font-semibold text-white hover:border-slate-500 transition-colors"
          >
            <Icon name="mobile" class="w-4 h-4" />
            <span>Download on the App Store</span>
          </a>
        </div>

      </div>

      <!-- Column 2 — Exams -->
      <div>
        <h3 class="text-xs font-semibold text-white uppercase tracking-[0.16em] mb-4">Exams</h3>
        <ul class="space-y-2.5 text-sm">
          {examLinks.map(l => (
            <li>
              <a href={l.href} class="text-slate-400 hover:text-sky-300 transition-colors duration-200">
                {l.label}
                {l.comingSoon && <span class="ml-1.5 text-[10px] uppercase tracking-wide text-slate-600">(Coming Soon)</span>}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 3 — Products -->
      <div>
        <h3 class="text-xs font-semibold text-white uppercase tracking-[0.16em] mb-4">Products</h3>
        <ul class="space-y-2.5 text-sm">
          {productLinks.map(l => (
            <li><a href={l.href} class="text-slate-400 hover:text-sky-300 transition-colors duration-200">{l.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Column 4 — Resources -->
      <div>
        <h3 class="text-xs font-semibold text-white uppercase tracking-[0.16em] mb-4">Resources</h3>
        <ul class="space-y-2.5 text-sm">
          {resourceLinks.map(l => (
            <li><a href={l.href} class="text-slate-400 hover:text-sky-300 transition-colors duration-200">{l.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Column 5 — Company -->
      <div>
        <h3 class="text-xs font-semibold text-white uppercase tracking-[0.16em] mb-4">Company</h3>
        <ul class="space-y-2.5 text-sm">
          {companyLinks.map(l => (
            <li><a href={l.href} class="text-slate-400 hover:text-sky-300 transition-colors duration-200">{l.label}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-14 pt-8 border-t border-slate-800/80 flex flex-col md:flex-row justify-between items-center gap-4 text-center md:text-left">
      <div class="text-sm text-slate-500">
        <p>© {new Date().getFullYear()} {SITE.name}. All rights reserved.</p>
        <p class="text-xs text-slate-600 mt-1">Built by Ophthalmologists. For Ophthalmologists.</p>
      </div>
      <div class="flex gap-6 text-sm text-slate-500">
        <a href="/faq" class="hover:text-slate-300 transition-colors">Help</a>
        <a href="/faq#pricing-refunds" class="hover:text-slate-300 transition-colors">Pricing & refunds</a>
        <a href="/contact" class="hover:text-slate-300 transition-colors">Contact</a>
      </div>
    </div>
  </div>
</footer>
