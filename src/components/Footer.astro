---
import { SITE, COM_BASE, CHECKOUT, EXAMS } from '../config';
import Icon from './Icon.astro';
---

<footer class="bg-slate-900 text-slate-300">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-8 lg:gap-12">
      <!-- Brand -->
      <div class="col-span-2 md:col-span-3 lg:col-span-1">
        <a href="/" class="flex items-center gap-2 mb-4">
          <img src="/logo.png" alt="" class="w-8 h-8 object-contain" />
          <span class="text-lg font-bold text-white">{SITE.name}</span>
        </a>
        <p class="text-sm text-slate-400 leading-relaxed mb-4">
          The only ophthalmology exam preparation platform built by doctors who passed these exams.
        </p>
        <div class="flex gap-3">
          <a href="#" aria-label="YouTube" class="text-slate-400 hover:text-white transition-colors">
            <Icon name="play" class="w-5 h-5" />
          </a>
          <a href="#" aria-label="Instagram" class="text-slate-400 hover:text-white transition-colors">
            <Icon name="mobile" class="w-5 h-5" />
          </a>
          <a href="#" aria-label="Telegram" class="text-slate-400 hover:text-white transition-colors">
            <Icon name="chat" class="w-5 h-5" />
          </a>
        </div>
      </div>

      <!-- Product -->
      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">Product</h3>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/free-mcqs" class="hover:text-white transition-colors">Free MCQs</a></li>
          <li><a href="/notes" class="hover:text-white transition-colors">Handwritten Notes</a></li>
          <li><a href="/topics" class="hover:text-white transition-colors">Topic MCQs</a></li>
          <li><a href="/exams" class="hover:text-white transition-colors">Exam Banks</a></li>
          <li><a href="/resources" class="hover:text-white transition-colors">Free Resources</a></li>
          <li><a href={`${COM_BASE}/purchases?type=10`} class="hover:text-white transition-colors">My Purchases</a></li>
        </ul>
      </div>

      <!-- Exams -->
      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">Exams</h3>
        <ul class="space-y-2.5 text-sm">
          {EXAMS.slice(0, 5).map(e => (
            <li><a href={`/exams/${e.slug}`} class="hover:text-white transition-colors">{e.name}</a></li>
          ))}
          <li><a href="/exams" class="text-sky-400 hover:text-sky-300 transition-colors">All Exams →</a></li>
        </ul>
      </div>

      <!-- Resources -->
      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">Resources</h3>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/blog" class="hover:text-white transition-colors">Blog</a></li>
          <li><a href="/topics" class="hover:text-white transition-colors">Topic MCQs</a></li>
          <li><a href="/glossary" class="hover:text-white transition-colors">Glossary</a></li>
          <li><a href="/resources" class="hover:text-white transition-colors">Free Resources</a></li>
          <li><a href="/success-stories" class="hover:text-white transition-colors">Success Stories</a></li>
          <li><a href="/faq" class="hover:text-white transition-colors">FAQ</a></li>
        </ul>
      </div>

      <!-- Company -->
      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">Company</h3>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/about" class="hover:text-white transition-colors">About Us</a></li>
          <li><a href="/contact" class="hover:text-white transition-colors">Contact</a></li>
          <li><a href="/institutions" class="hover:text-white transition-colors">Institutional Sales</a></li>
          <li><a href={CHECKOUT.settings} class="hover:text-white transition-colors">My Account</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-slate-800 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-sm text-slate-500">© {new Date().getFullYear()} {SITE.name}. All rights reserved.</p>
      <div class="flex gap-6 text-sm text-slate-500">
        <a href="/terms" class="hover:text-slate-300 transition-colors">Terms</a>
        <a href="/privacy" class="hover:text-slate-300 transition-colors">Privacy</a>
        <a href="/refunds" class="hover:text-slate-300 transition-colors">Refunds</a>
      </div>
    </div>
  </div>
</footer>
