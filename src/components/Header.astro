---
import { SITE, NAV, CHECKOUT } from '../config';
import Icon from './Icon.astro';

const currentPath = Astro.url.pathname;
---

<header class="site-header sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-slate-200/80">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-[4.25rem] items-center justify-between">
      <!-- Logo -->
      <a href="/" class="group flex items-center gap-2.5 shrink-0">
        <span class="relative flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-sky-50 to-white ring-1 ring-slate-200/80 shadow-sm transition-transform duration-300 group-hover:scale-105">
          <img src="/logo.png" alt="" class="w-7 h-7 object-contain" />
        </span>
        <span class="text-lg font-bold text-slate-900 tracking-tight">
          {SITE.name}
        </span>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden lg:flex items-center gap-0.5" aria-label="Primary">
        {NAV.map((item) => {
          const active = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class:list={[
                'nav-link px-3.5 py-2 rounded-lg text-sm font-medium transition-colors duration-200',
                active
                  ? 'is-active text-sky-700'
                  : 'text-slate-600 hover:text-slate-900',
              ]}
            >
              {item.label}
            </a>
          );
        })}
        <a
          href={CHECKOUT.settings}
          class="nav-link px-3.5 py-2 rounded-lg text-sm font-medium text-slate-600 hover:text-slate-900 transition-colors duration-200"
        >
          My Account
        </a>
      </nav>

      <!-- CTA -->
      <div class="hidden lg:flex items-center gap-3">
        <a
          href="/notes"
          class="inline-flex items-center gap-1.5 rounded-xl bg-sky-600 px-4 py-2.5 text-sm font-semibold text-white"
        >
          Explore Products
          <Icon name="arrowRight" class="w-4 h-4 opacity-90" />
        </a>
      </div>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="lg:hidden inline-flex items-center justify-center rounded-xl p-2.5 text-slate-600 hover:bg-slate-100/80 ring-1 ring-transparent hover:ring-slate-200 transition-all"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="menu" class="h-6 w-6" id="menu-icon-open" />
        <Icon name="close" class="h-6 w-6 hidden" id="menu-icon-close" />
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="mobile-menu lg:hidden border-t border-slate-200/80 bg-white/95 backdrop-blur-md">
    <div class="space-y-1 px-4 py-4">
      {NAV.map((item) => {
        const active = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
        return (
          <a
            href={item.href}
            class:list={[
              'block rounded-xl px-3.5 py-2.5 text-base font-medium transition-colors',
              active
                ? 'text-sky-700 bg-sky-50'
                : 'text-slate-600 hover:text-slate-900 hover:bg-slate-50',
            ]}
          >
            {item.label}
          </a>
        );
      })}
      <a href={CHECKOUT.settings} class="block rounded-xl px-3.5 py-2.5 text-base font-medium text-slate-600 hover:bg-slate-50">
        My Account
      </a>
      <div class="pt-3">
        <a
          href="/notes"
          class="block text-center rounded-xl px-4 py-3 text-sm font-semibold text-white bg-sky-600"
        >
          Explore Products
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('is-open');
    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    iconOpen?.classList.toggle('hidden', !!open);
    iconClose?.classList.toggle('hidden', !open);
  });
</script>
