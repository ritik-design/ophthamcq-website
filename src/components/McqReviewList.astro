---
/**
 * Server-rendered list of every MCQ in a category, with options, the correct
 * answer and the explanation.
 *
 * The interactive quiz builds its DOM from a JS array, so none of the question
 * text reached the HTML Google receives — seven pages targeting the site's
 * highest-intent keyword shipped ~350 words of boilerplate and a price list.
 * The stem and options render as plain markup; only the answer sits behind a
 * <details> so the page stays scannable and the quiz above is not spoiled at a
 * glance.
 */
import { CATEGORY_MCQS, getCategoryById, type CategoryId } from '../data/categories';

export interface Props {
  categoryId: CategoryId;
}

const { categoryId } = Astro.props;
const category = getCategoryById(categoryId);
const mcqs = CATEGORY_MCQS[categoryId] ?? [];

const LETTERS = ['A', 'B', 'C', 'D', 'E', 'F'];
---

{
  category && mcqs.length > 0 && (
    <section id="all-questions" class="bg-white border-t border-slate-200 py-16 lg:py-20">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <div class="mb-10">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-sky-700 mb-3">
            Full question bank
          </p>
          <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">
            All {mcqs.length} free {category.name} MCQs, with answers and explanations
          </h2>
          <p class="mt-3 text-slate-600 max-w-2xl">
            The quiz above serves a random {category.quizSize} of these each time you retake it.
            Every question in the set is listed below — read the stem, commit to an option, then
            open the answer to check your reasoning against the explanation.
          </p>
        </div>

        <ol class="space-y-6 list-none p-0 m-0">
          {mcqs.map((mcq, index) => (
            <li
              id={`q-${mcq.id}`}
              class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 scroll-mt-24"
            >
              <div class="flex items-start gap-3">
                <span class="mt-0.5 inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-sky-50 text-xs font-bold text-sky-700 tabular-nums">
                  {index + 1}
                </span>
                <h3 class="text-base sm:text-lg font-semibold text-slate-900 leading-relaxed m-0">
                  {mcq.q}
                </h3>
              </div>

              <ul class="mt-4 ml-10 space-y-2 list-none p-0">
                {mcq.options.map((option, i) => (
                  <li class="flex items-start gap-2.5 text-slate-700">
                    <span class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded border border-slate-300 text-[11px] font-semibold text-slate-500">
                      {LETTERS[i] ?? i + 1}
                    </span>
                    <span class="text-sm sm:text-base leading-relaxed">{option}</span>
                  </li>
                ))}
              </ul>

              <details class="mt-4 ml-10 group">
                <summary class="cursor-pointer list-none inline-flex items-center gap-2 rounded-lg bg-slate-50 border border-slate-200 px-3 py-1.5 text-sm font-semibold text-slate-700 hover:bg-slate-100 transition-colors">
                  <span class="group-open:hidden">Show answer and explanation</span>
                  <span class="hidden group-open:inline">Hide answer</span>
                </summary>
                <div class="mt-3 rounded-xl border border-emerald-200 bg-emerald-50/60 p-4">
                  <p class="text-sm font-bold text-emerald-900 m-0">
                    Answer: {LETTERS[mcq.correct] ?? mcq.correct + 1} — {mcq.options[mcq.correct]}
                  </p>
                  <p class="mt-2 text-sm text-slate-700 leading-relaxed m-0">{mcq.explanation}</p>
                </div>
              </details>
            </li>
          ))}
        </ol>

        <p class="mt-10 text-sm text-slate-500">
          These {mcqs.length} questions are a free sample. The full {category.name} bundle carries{' '}
          {category.fullQuestionCount} questions with the same depth of explanation —{' '}
          <a href="#bundle" class="font-semibold text-sky-700 hover:text-sky-800">
            see what is included
          </a>
          .
        </p>
      </div>
    </section>
  )
}
