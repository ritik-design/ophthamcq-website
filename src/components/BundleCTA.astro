---
import Icon from './Icon.astro';
import { PRODUCTS, COM_BASE } from '../config';
import { getCategoryById, type CategoryId } from '../data/categories';

export interface Props {
  categoryId: CategoryId;
}

const { categoryId } = Astro.props;
const category = getCategoryById(categoryId);
const products = category?.productIds
  .map((id) => PRODUCTS.find((p) => p.id === id))
  .filter(Boolean) ?? [];
---

{
  category && (
    <div class="rounded-2xl bg-white border border-slate-200 shadow-sm overflow-hidden">
      <div class="bg-sky-600 px-6 py-4">
        <div class="flex items-center gap-3">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-white/10 text-white">
            <Icon name={category.iconName} class="h-5 w-5" />
          </div>
          <div>
            <h3 class="text-lg font-bold text-white">{category.name}</h3>
            <p class="text-sm text-sky-100">{category.description}</p>
          </div>
        </div>
      </div>

      <div class="p-6 lg:p-8 space-y-6">
        <!-- Included products -->
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {products.map((product) => (
            <div class="rounded-xl border border-slate-200 bg-white p-4 flex flex-col">
              <div class="aspect-video rounded-lg bg-slate-100 overflow-hidden mb-4">
                <img
                  src={product?.image}
                  alt={product?.fullName}
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              </div>
              <h4 class="font-bold text-slate-900 mb-1">{product?.name}</h4>
              <p class="text-xs text-slate-600 line-clamp-2 mb-3 flex-1">{product?.description}</p>
              <div class="flex items-baseline gap-2 mb-3">
                <span class="text-lg font-bold text-slate-900">{product?.price}</span>
                {product?.oldPrice && (
                  <span class="text-sm text-slate-400 line-through">{product.oldPrice}</span>
                )}
                {product?.discount && (
                  <span class="text-xs font-medium text-emerald-600 bg-emerald-50 px-1.5 py-0.5 rounded">
                    Save {product.discount}
                  </span>
                )}
              </div>
              <a
                href={product?.href}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700 transition-colors"
              >
                Buy Now
                <Icon name="externalLink" class="h-4 w-4" />
              </a>
            </div>
          ))}
        </div>

        <div class="grid md:grid-cols-2 gap-6">
          <div class="rounded-2xl bg-slate-50 border border-slate-200 p-5">
            <h4 class="text-sm font-bold text-slate-900 uppercase tracking-wide mb-3 flex items-center gap-2">
              <Icon name="check" class="h-4 w-4 text-emerald-500" />
              What's Included
            </h4>
            <ul class="space-y-2">
              {category.benefits.map((benefit) => (
                <li class="flex items-start gap-2 text-sm text-slate-700">
                  <span class="text-emerald-500 font-bold">✓</span>
                  {benefit}
                </li>
              ))}
            </ul>
          </div>

          <div class="rounded-2xl bg-slate-50 border border-slate-200 p-5">
            <h4 class="text-sm font-bold text-slate-900 uppercase tracking-wide mb-3 flex items-center gap-2">
              <Icon name="bookOpen" class="h-4 w-4 text-sky-600" />
              Covered Topics
            </h4>
            <ul class="space-y-2">
              {category.includedTopics.slice(0, 6).map((topic) => (
                <li class="flex items-start gap-2 text-sm text-slate-700">
                  <span class="text-emerald-500 font-bold">✓</span>
                  {topic}
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="text-center pt-2">
          <a
            href={`${COM_BASE}/new-courses`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-600 px-8 py-4 text-base font-semibold text-white shadow-lg hover:bg-emerald-700 transition-colors"
          >
            Buy the Full {category.name} Bundle
            <Icon name="externalLink" class="h-5 w-5" />
          </a>
          <p class="mt-3 text-sm text-slate-500">Instant access after purchase. Available on Android & iOS app.</p>
        </div>
      </div>
    </div>
  )
}
