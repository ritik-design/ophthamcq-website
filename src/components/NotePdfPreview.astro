---
/**
 * Full PDF viewer for exam notes + primary CTA to the matching product on ophthamcq.com.
 */
import Icon from './Icon.astro';
import { PRODUCTS } from '../config';
import { getNotePreview, type NotePreview } from '../data/note-previews';

interface Props {
  productId: string;
  /** Optional override; defaults to PRODUCTS href on .com */
  storeHref?: string;
  compact?: boolean;
}

const { productId, storeHref, compact = false } = Astro.props;

const meta: NotePreview | undefined = getNotePreview(productId);
const product = PRODUCTS.find(p => p.id === productId);

const buyHref = storeHref ?? product?.href ?? 'https://www.ophthamcq.com';
const title = product?.name ?? productId;
const price = product?.price;
const oldPrice = product?.oldPrice;
const discount = product?.discount;
const pdfSrc = meta?.publicPdf;
---

{meta && pdfSrc && (
  <section
    class:list={[
      'note-pdf-preview',
      compact ? 'note-pdf-preview--compact' : '',
    ]}
    aria-labelledby={`note-preview-${productId}-heading`}
  >
    <div class:list={[compact ? '' : 'mx-auto max-w-4xl']}>
      {!compact && (
        <div class="mb-6 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
          <div>
            <p class="text-xs font-semibold uppercase tracking-widest text-sky-700 mb-1">
              Full PDF · Buy on store
            </p>
            <h2
              id={`note-preview-${productId}-heading`}
              class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight"
            >
              {title}
            </h2>
            <p class="mt-2 text-sm text-slate-600 max-w-xl">
              Browse the complete PDF below. Purchase lifetime access on{' '}
              <span class="font-semibold text-slate-800">ophthamcq.com</span>.
            </p>
          </div>
          <div class="flex flex-col items-stretch sm:items-end gap-2 shrink-0">
            {price && (
              <div class="flex items-baseline gap-2">
                <span class="text-2xl font-bold text-slate-900">{price}</span>
                {oldPrice && (
                  <span class="text-sm text-slate-400 line-through">{oldPrice}</span>
                )}
                {discount && (
                  <span class="text-xs font-medium text-emerald-700 bg-emerald-50 border border-emerald-200 px-1.5 py-0.5 rounded">
                    Save {discount}
                  </span>
                )}
              </div>
            )}
            <a
              href={buyHref}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 rounded-xl bg-sky-600 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-sky-200 hover:bg-sky-700 transition-colors"
            >
              {meta.lockedLabel}
              <Icon name="externalLink" class="w-4 h-4" />
            </a>
          </div>
        </div>
      )}

      <div class="rounded-2xl border border-slate-200 bg-slate-100 overflow-hidden shadow-sm">
        <!-- Sticky store CTA -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 border-b border-slate-200 bg-white px-4 py-3">
          <p class="text-sm text-slate-600">
            <span class="font-semibold text-slate-900">{title}</span>
            {' '}— full PDF viewer
          </p>
          <div class="flex flex-col sm:flex-row gap-2">
            <a
              href={pdfSrc}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 rounded-xl bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 border-2 border-slate-200 hover:border-sky-300 hover:text-sky-700 transition-colors"
            >
              Open PDF in new tab
              <Icon name="externalLink" class="w-4 h-4" />
            </a>
            <a
              href={buyHref}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 rounded-xl bg-sky-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-sky-700 transition-colors"
            >
              Buy on ophthamcq.com
              <Icon name="externalLink" class="w-4 h-4" />
            </a>
          </div>
        </div>

        <!-- Full PDF embed -->
        <div class="relative bg-slate-200/80">
          <iframe
            src={`${pdfSrc}#view=FitH`}
            title={`Full PDF: ${title}`}
            class="w-full border-0 bg-white"
            style="height: min(80vh, 900px); min-height: 480px;"
            loading="lazy"
          />
        </div>

        <div class="border-t border-slate-200 bg-white px-4 py-4 flex flex-col sm:flex-row items-center justify-between gap-3">
          <p class="text-xs sm:text-sm text-slate-600 text-center sm:text-left max-w-lg">
            {meta.lockCopy}
          </p>
          <a
            href={buyHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-sky-600 px-5 py-3 text-sm font-semibold text-white shadow-md hover:bg-sky-700 transition-colors shrink-0"
          >
            Get on OphthaMCQ Store
            <Icon name="arrowRight" class="w-4 h-4" />
          </a>
        </div>
      </div>
    </div>
  </section>
)}
