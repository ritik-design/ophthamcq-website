---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import FinalCTA from '../../components/sections/FinalCTA.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
type LocalPostModule = { Content: any; frontmatter: Record<string, string> };

export function getStaticPaths() {
  const localPosts = import.meta.glob('../../../docs/content-drafts/first-100/*.md', { eager: true });
  const posts = Object.entries(localPosts as Record<string, LocalPostModule>)
    .filter(([path]) => !/\/(17|18|19|077|078)-/.test(path))
    .map(([, { frontmatter }]) => frontmatter)
    .filter((post) => post.proposed_slug);
  return posts.map((post) => ({ params: { slug: post.proposed_slug } }));
}

const localPosts = import.meta.glob('../../../docs/content-drafts/first-100/*.md', { eager: true });
const posts = Object.entries(localPosts as Record<string, LocalPostModule>)
  .filter(([path]) => !/\/(17|18|19|077|078)-/.test(path))
  .map(([, { Content, frontmatter }]) => ({ Content, ...frontmatter }))
  .filter((post) => post.proposed_slug);
const { slug } = Astro.params;
const post = posts.find((item) => item.proposed_slug === slug);
if (!post) throw new Error(`Local blog draft not found for slug: ${slug}`);
const { Content } = post;
const readTime = post.estimated_read_time || 'Read';

const canonical = new URL(Astro.url.pathname, 'https://ophthamcq.org').href;

const articleSchema = {
  '@type': 'Article',
  '@id': `${canonical}#article`,
  headline: post.title,
  description: post.meta_description || post.excerpt,
  datePublished: post.date,
  dateModified: post.last_updated || post.fact_check_date || post.date,
  author: { '@type': 'Organization', name: post.author || 'OphthaMCQ Editorial Team' },
  publisher: { '@id': 'https://ophthamcq.org/#organization' },
  image: 'https://ophthamcq.org/og-image.jpg',
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  articleSection: post.category || 'General',
  ...(post.primary_keyword ? { keywords: post.primary_keyword } : {}),
};
---

<Layout
  title={post.seo_title || post.title}
  description={post.meta_description || post.excerpt}
  ogType="article"
  breadcrumbs={[{ name: 'Blog', href: '/blog/' }, { name: post.seo_title || post.title }]}
  schema={[articleSchema]}
>
  <article class="bg-white">
    <div class="border-b border-slate-200">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
        <div class="flex flex-wrap items-center gap-3 mb-6">
          <span class="inline-flex items-center rounded-full bg-sky-50 px-3 py-1 text-sm font-medium text-sky-700">{post.category || 'General'}</span>
          <span class="text-sm text-slate-400">
            {post.date && <time datetime={post.date}>{post.date}</time>}
            {post.date && ' • '}{readTime}
          </span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight mb-6">
          {post.title}
        </h1>
        <div class="flex items-center gap-3 pt-4 border-t border-slate-100">
          <div class="h-10 w-10 rounded-full bg-sky-100 flex items-center justify-center text-sky-700 font-bold">D</div>
          <div>
            <div class="text-sm font-semibold text-slate-900">{post.author}</div>
            <div class="text-xs text-slate-500">Reviewed by qualified ophthalmologists</div>
          </div>
        </div>
      </div>
    </div>

    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-12">
      <div class="prose prose-lg prose-slate max-w-none thestacc-content">
        <Content />
      </div>

      <div class="mt-12 p-6 rounded-2xl bg-sky-50 border border-sky-100">
        <h3 class="text-lg font-bold text-slate-900 mb-2">Ready to apply what you learned?</h3>
        <p class="text-slate-600 mb-4">Practice 10,000+ MCQs with detailed explanations and track your progress.</p>
        <a href="/free-mcqs/" class="inline-flex items-center gap-2 rounded-xl bg-sky-600 px-6 py-3 text-sm font-semibold text-white hover:bg-sky-700 transition-colors">
          Start Free Practice
          <Icon name="arrowRight" class="w-4 h-4" />
        </a>
      </div>
    </div>
  </article>

  <RelatedPosts post={post} allPosts={posts} />

  <FinalCTA />
</Layout>

<style is:global>
  .thestacc-content img {
    border-radius: 1rem;
    margin: 1.5rem 0;
  }
  .thestacc-content blockquote {
    border-left: 4px solid #0ea5e9;
    background-color: #f0f9ff;
    padding: 1rem 1.5rem;
    border-radius: 0 0.75rem 0.75rem 0;
    font-style: italic;
  }
  /* Tables are wrapped in .table-scroll by rehype-wrap-tables so a wide table
     scrolls inside its own box instead of dragging the page sideways. */
  .thestacc-content .table-scroll {
    margin: 1.5rem 0;
    /* Fades the right edge while there is more table to scroll to, so the
       overflow is discoverable rather than silently cut off. */
    background:
      linear-gradient(to right, #fff 30%, transparent) left / 3rem 100% no-repeat,
      linear-gradient(to left, #fff 30%, transparent) right / 3rem 100% no-repeat,
      radial-gradient(farthest-side at 0 50%, rgb(15 23 42 / 0.12), transparent) left / 1rem 100% no-repeat,
      radial-gradient(farthest-side at 100% 50%, rgb(15 23 42 / 0.12), transparent) right / 1rem 100% no-repeat;
    background-attachment: local, local, scroll, scroll;
  }
  .thestacc-content .table-scroll:focus-visible {
    outline: 2px solid #0ea5e9;
    outline-offset: 2px;
    border-radius: 0.5rem;
  }
  .thestacc-content table {
    width: 100%;
    border-collapse: collapse;
    margin: 0;
    font-size: 0.95rem;
  }
  /* Below these widths columns collapse into one-word-per-line mush, so let the
     container scroll instead. Two-column tables stay fluid at any width. */
  .thestacc-content table[data-cols="3"] { min-width: 34rem; }
  .thestacc-content table[data-cols="4"] { min-width: 44rem; }
  .thestacc-content table[data-cols="5"] { min-width: 52rem; }
  .thestacc-content table[data-cols="6"] { min-width: 60rem; }
  .thestacc-content table[data-cols="7"] { min-width: 68rem; }
  .thestacc-content th,
  .thestacc-content td {
    border: 1px solid #e2e8f0;
    padding: 0.75rem 1rem;
    text-align: left;
    vertical-align: top;
  }
  .thestacc-content th {
    background-color: #f1f5f9;
    font-weight: 600;
  }
  @media (max-width: 640px) {
    .thestacc-content table { font-size: 0.875rem; }
    .thestacc-content th,
    .thestacc-content td { padding: 0.625rem 0.75rem; }
  }
</style>
