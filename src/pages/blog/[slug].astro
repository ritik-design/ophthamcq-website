---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import Illustration from '../../components/Illustration.astro';
import FinalCTA from '../../components/sections/FinalCTA.astro';
import { fetchBlogBySlug, fetchBlogList, fetchBlogSitemap, normalizeBlog } from '../../lib/thestacc';

export async function getStaticPaths() {
  // Prefer the sitemap endpoint, fall back to the blog list, then local content.
  let slugs: string[] = [];

  const sitemap = await fetchBlogSitemap();
  if (sitemap && sitemap.length > 0) {
    slugs = sitemap.map(item => item.slug).filter(Boolean);
  }

  if (slugs.length === 0) {
    const apiPosts = await fetchBlogList();
    slugs = apiPosts.map(post => post.slug).filter(Boolean);
  }

  if (slugs.length === 0) {
    const local = await getCollection('blog');
    slugs = local.map(entry => entry.data.slug);
  }

  return slugs.map(slug => ({ params: { slug } }));
}

const { slug } = Astro.params;

// Try API first, fall back to local content.
let apiPost = await fetchBlogBySlug(slug || '');
let localPost = null;
let Content = null;

if (apiPost) {
  apiPost = normalizeBlog(apiPost);
} else {
  const local = await getCollection('blog');
  localPost = local.find(entry => entry.data.slug === slug) || null;
  if (localPost) {
    const rendered = await render(localPost);
    Content = rendered.Content;
  }
}

const post = apiPost || localPost?.data;
const title = apiPost?.title || localPost?.data.title || 'Blog Post';
const excerpt = apiPost?.excerpt || apiPost?.meta_description || localPost?.data.excerpt || title;
const category = apiPost?.category || localPost?.data.category || 'General';
const date = apiPost?.date || localPost?.data.date || new Date().toISOString().split('T')[0];
const readTime = apiPost?.readTime || localPost?.data.readTime || '5 min read';
const illustration = apiPost?.illustration || localPost?.data.illustration || 'blog';
const author = apiPost?.author || localPost?.data.author || 'Dr. OphthaMCQ Editorial Team';
---

<Layout title={title} description={excerpt}>
  <article class="bg-white">
    <div class="border-b border-slate-200">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
        <div class="flex flex-wrap items-center gap-3 mb-6">
          <span class="inline-flex items-center rounded-full bg-sky-50 px-3 py-1 text-sm font-medium text-sky-700">{category}</span>
          <span class="text-sm text-slate-400">{date} • {readTime}</span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight mb-6">
          {title}
        </h1>
        <div class="flex items-center gap-3 pt-4 border-t border-slate-100">
          <div class="h-10 w-10 rounded-full bg-sky-100 flex items-center justify-center text-sky-700 font-bold">D</div>
          <div>
            <div class="text-sm font-semibold text-slate-900">{author}</div>
            <div class="text-xs text-slate-500">Reviewed by qualified ophthalmologists</div>
          </div>
        </div>
      </div>
    </div>

    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-12">
      <div class="w-full h-64 rounded-2xl bg-sky-50 flex items-center justify-center mb-12">
        <Illustration name={illustration} class="w-48 h-48" />
      </div>

      <div class="prose prose-lg prose-slate max-w-none">
        {apiPost?.content ? (
          <div set:html={apiPost.content} />
        ) : Content ? (
          <Content />
        ) : (
          <p class="text-slate-600">Post not found.</p>
        )}
      </div>

      <div class="mt-12 p-6 rounded-2xl bg-sky-50 border border-sky-100">
        <h3 class="text-lg font-bold text-slate-900 mb-2">Ready to apply what you learned?</h3>
        <p class="text-slate-600 mb-4">Practice 10,000+ MCQs with detailed explanations and track your progress.</p>
        <a href="/free-mcqs/" class="inline-flex items-center gap-2 rounded-xl bg-sky-600 px-6 py-3 text-sm font-semibold text-white hover:bg-sky-700 transition-colors">
          Start Free Practice
          <Icon name="arrowRight" class="w-4 h-4" />
        </a>
      </div>
    </div>
  </article>

  <FinalCTA />
</Layout>
