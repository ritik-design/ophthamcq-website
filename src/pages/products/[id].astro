---
import Layout from '../../layouts/Layout.astro';
import { PRODUCTS } from '../../config';
import Icon from '../../components/Icon.astro';
import FinalCTA from '../../components/sections/FinalCTA.astro';

export function getStaticPaths() {
  return PRODUCTS.map(p => ({ params: { id: p.id } }));
}

const { id } = Astro.params;
const product = PRODUCTS.find(p => p.id === id);

if (!product) {
  return Astro.redirect('/notes');
}
---

<Layout
  title={`${product.name} — ${product.fullName}`}
  description={product.description}
>
  <div class="bg-white border-b border-slate-200">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div class="text-center lg:text-left">
          <div class="inline-flex items-center gap-2 rounded-full bg-amber-50 border border-amber-100 px-3 py-1 mb-4">
            <span class="text-sm font-semibold text-amber-700">{product.tag || 'Popular'}</span>
          </div>
          <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 tracking-tight">
            {product.name}
          </h1>
          <p class="mt-5 text-lg text-slate-600 max-w-xl mx-auto lg:mx-0">
            {product.description}
          </p>
          <div class="mt-6 flex items-baseline gap-3 justify-center lg:justify-start">
            <span class="text-3xl font-bold text-slate-900">{product.price}</span>
            {product.oldPrice && <span class="text-lg text-slate-400 line-through">{product.oldPrice}</span>}
            {product.discount && <span class="text-sm font-medium text-emerald-600 bg-emerald-50 px-2 py-1 rounded">Save {product.discount}</span>}
          </div>
          <a
            href={product.href}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-8 inline-flex items-center justify-center gap-2 rounded-xl bg-sky-600 px-8 py-4 text-base font-semibold text-white shadow-lg hover:bg-sky-700 transition-colors"
          >
            Buy on Store
            <Icon name="externalLink" class="w-5 h-5" />
          </a>
        </div>
        <div class="flex justify-center">
          <div class="w-full max-w-md aspect-square rounded-2xl bg-slate-100 overflow-hidden shadow-md">
            <img
              src={product.image}
              alt={product.fullName}
              class="w-full h-full object-cover"
            />
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="bg-slate-50 py-16 lg:py-24">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-slate-900 mb-6">What's Included</h2>
      <div class="grid sm:grid-cols-2 gap-4">
        {[
          'Expert-written content',
          'Detailed explanations',
          'Exam-focused format',
          'Mobile app access',
          'Instant PDF download',
          'Regular updates',
        ].map(item => (
          <div class="flex items-center gap-3 rounded-xl bg-white border border-slate-200 p-4">
            <Icon name="check" class="w-5 h-5 text-emerald-500 shrink-0" />
            <span class="text-sm font-medium text-slate-700">{item}</span>
          </div>
        ))}
      </div>

      <div class="mt-12 p-6 rounded-2xl bg-white border border-slate-200">
        <h3 class="text-lg font-bold text-slate-900 mb-2">Not sure if this is right for you?</h3>
        <p class="text-slate-600 mb-4">Start with 50 free MCQs and see the quality for yourself.</p>
        <a href="/free-mcqs" class="inline-flex items-center gap-2 rounded-xl bg-sky-600 px-6 py-3 text-sm font-semibold text-white hover:bg-sky-700 transition-colors">
          Try Free MCQs
          <Icon name="arrowRight" class="w-4 h-4" />
        </a>
      </div>
    </div>
  </div>

  <FinalCTA />
</Layout>
