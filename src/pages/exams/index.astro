---
import Layout from '../../layouts/Layout.astro';
import { EXAMS } from '../../config';
import Icon from '../../components/Icon.astro';
import FinalCTA from '../../components/sections/FinalCTA.astro';
---

<Layout
  title="All Exams — FRCOphth, ICO, FAICO, DNB, NEET-SS, PD-CET, OKAPs"
  description="Dedicated question banks and notes for every major ophthalmology exam. FRCOphth, ICO, FAICO, DNB, NEET-SS, PD-CET, and OKAPs."
>
  <div class="bg-white border-b border-slate-200">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
      <div class="text-center max-w-3xl mx-auto">
        <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 tracking-tight">
          Prepare for <span class="text-sky-600">Any Exam</span>
        </h1>
        <p class="mt-5 text-lg text-slate-600">
          Dedicated question banks, handwritten notes, and past papers for every major ophthalmology examination.
        </p>
      </div>
    </div>
  </div>

  <div class="bg-slate-50 py-16 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {EXAMS.map(exam => (
          <a
            href={`/exams/${exam.slug}`}
            class="group relative flex flex-col rounded-2xl border border-slate-200 bg-white p-8 hover:shadow-lg hover:border-sky-200 transition-all duration-300"
          >
            <div class="w-12 h-12 rounded-lg bg-sky-50 flex items-center justify-center mb-4">
              <Icon name={exam.iconName} class="w-6 h-6 text-sky-600" />
            </div>
            <h2 class="text-xl font-bold text-slate-900 mb-1">{exam.full}</h2>
            <p class="text-sm text-slate-500 mb-4">{exam.description}</p>
            <p class="text-sm text-slate-600 leading-relaxed flex-1">
              Syllabus-mapped MCQs, handwritten notes, and past papers with full explanations.
            </p>
            <div class="mt-6 pt-4 border-t border-slate-100">
              <span class="text-sm font-semibold text-sky-600 group-hover:text-sky-700 flex items-center gap-1">
                View Exam Resources
                <Icon name="chevronRight" class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" />
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>

  <FinalCTA />
</Layout>
