    productIds: ['high-yield-mcqs', 'optics-notes', 'retina-deciphered', 'anatomy-notes'],
    timeline: [
      { phase: 'PGY1 / early PGY2', weeks: 'Months 1–6', focus: 'Read BCSC 3 (Optics) and BCSC 2 (Fundamentals). Light topic MCQs.' },
      { phase: 'PGY2 build', weeks: 'Months 7–18', focus: 'Rotate through BCSC sections aligned with clinic rotations. Topic-wise MCQs weekly.' },
      { phase: 'Pre-exam', weeks: 'Final 8 weeks', focus: 'Full mocks weekly. Spaced repetition on flagged questions. BCSC quick-recall summaries.' },
    ],
    pitfalls: [
      'Trying to read all 13 BCSC sections cover-to-cover',
      'Skipping optics — it is heavily tested',
      'Cramming the week before; OKAPs rewards spaced practice',
      'Ignoring image-based questions',
    ],
    tips: [
      'Anchor your study to BCSC sections, not random topic order',
      'Use OphthaMCQ topic banks to drill weak BCSC sections',
      'Set a target percentile with your programme director and reverse-plan from there',
      'Run two full-length mocks under exam conditions in the final 4 weeks',
    ],
    textbooks: [
      { title: 'BCSC (Basic and Clinical Science Course)', why: 'The OKAPs blueprint is built directly from BCSC.' },
      { title: 'Kanski Clinical Ophthalmology', why: 'Useful complement to BCSC for clinical depth.' },
      { title: 'Friedman — Review of Ophthalmology', why: 'Concise pre-exam review.' },
    ],
    pastPapers: 'The AAO does not publish OKAP past papers. Our high-yield bank and topic MCQs are aligned to BCSC chapter weights, which match the blueprint closely.',
    testimonialFilter: [],
    faqs: [
      { q: 'When should I take OKAPs?', a: 'OKAPs is administered annually in March. All US ophthalmology residents take it each year as a programme-wide assessment.' },
      { q: 'Is there a pass mark for OKAPs?', a: 'OKAPs reports percentiles rather than pass/fail. Programmes set their own expectations, often around the 30th–50th percentile.' },
      { q: 'Best resource for OKAPs?', a: 'BCSC plus a BCSC-aligned MCQ bank. Pair with topic-wise handwritten notes for the final weeks.' },
      { q: 'How long should I prepare for OKAPs?', a: 'Spread practice across the academic year. Heavy revision in the final 6–8 weeks.' },
      { q: 'Is OphthaMCQ aligned with BCSC?', a: 'Yes. Our high-yield bank maps to BCSC sections and uses the question style common across OKAPs and similar US in-training exams.' },
    ],
  },
};

const examData = content[slug!] ?? content.frcophth;
const matchedProducts = examData.productIds
  .map(id => PRODUCTS.find(p => p.id === id))
  .filter((p): p is typeof PRODUCTS[number] => Boolean(p));
const matchedTestimonials = examData.testimonialFilter.length
  ? TESTIMONIALS.filter(t => examData.testimonialFilter.some(f => t.exam.includes(f)))
  : [];
---

<Layout
  title={examData.seoTitle}
  description={examData.seoDescription}
>
  <div class="bg-white border-b border-slate-200">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 rounded-full bg-sky-50 border border-sky-100 px-3 py-1 mb-6">
          <Icon name={exam.iconName} class="w-4 h-4 text-sky-600" />
          <span class="text-sm font-medium text-sky-700">Exam Preparation</span>
        </div>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 tracking-tight">
          {exam.full} <span class="text-sky-600">Preparation</span>
        </h1>
        <p class="mt-5 text-lg text-slate-600">
          {exam.description}. Syllabus-mapped MCQ bank, handwritten notes and past paper patterns to help you pass on the first attempt.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row gap-4">
          <a href="/free-mcqs" class="inline-flex items-center justify-center rounded-xl bg-sky-600 px-6 py-3 text-sm font-semibold text-white hover:bg-sky-700 transition-colors">
            Try Free MCQs
          </a>
          <a href="/notes" class="inline-flex items-center justify-center rounded-xl bg-white px-6 py-3 text-sm font-semibold text-slate-700 border-2 border-slate-200 hover:border-sky-300 transition-colors">
            View Notes
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="bg-slate-50 py-16 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-3xl font-bold text-slate-900 tracking-tight">{exam.name} Exam Overview</h2>
        <p class="mt-3 text-slate-600">Format, duration and pass criteria broken down per part.</p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {examData.parts.map(part => (
          <div class="rounded-2xl border border-slate-200 bg-white p-6">
            <h3 class="text-lg font-bold text-slate-900 mb-3">{part.name}</h3>
            <dl class="space-y-2 text-sm">
              <div class="flex justify-between gap-2"><dt class="text-slate-500">Format</dt><dd class="text-slate-800 text-right">{part.format}</dd></div>
              <div class="flex justify-between gap-2"><dt class="text-slate-500">Duration</dt><dd class="text-slate-800 text-right">{part.duration}</dd></div>
              <div class="flex justify-between gap-2"><dt class="text-slate-500">Pass mark</dt><dd class="text-slate-800 text-right">{part.passMark}</dd></div>
            </dl>
            <p class="mt-4 text-sm text-slate-600 border-t border-slate-100 pt-4">{part.questions}</p>
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="bg-white py-16 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-3xl font-bold text-slate-900 tracking-tight">{exam.name} High-Yield Syllabus Topics</h2>
        <p class="mt-3 text-slate-600">The topics that pull the most marks. Drill these first.</p>
      </div>
      <div class="grid lg:grid-cols-2 gap-8">
        {examData.highYieldTopics.map(group => (
          <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6">
            <h3 class="text-lg font-bold text-slate-900 mb-4">{group.heading}</h3>
            <ul class="space-y-2">
              {group.items.map(item => (
                <li class="flex items-start gap-2 text-sm text-slate-700">
                  <Icon name="check" class="w-4 h-4 text-sky-600 mt-0.5 shrink-0" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <div class="mt-10 text-center">
        <a href="/topics" class="inline-flex items-center gap-2 text-sm font-semibold text-sky-700 hover:text-sky-800">
          Browse all ophthalmology topics
          <Icon name="chevronRight" class="w-4 h-4" />
        </a>
      </div>
    </div>
  </div>

  {matchedProducts.length > 0 && (
    <div class="bg-slate-50 py-16 lg:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-12">
          <h2 class="text-3xl font-bold text-slate-900 tracking-tight">Matched products for {exam.name}</h2>
          <p class="mt-3 text-slate-600">Our most-used resources for this exam, hand-picked from the OphthaMCQ catalog.</p>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {matchedProducts.map(p => (
            <a href={p.href} class="group flex flex-col rounded-2xl border border-slate-200 bg-white p-6 hover:shadow-lg hover:border-sky-200 transition-all">
              <div class="flex items-center gap-3 mb-3">
                <div class="w-10 h-10 rounded-lg bg-sky-50 flex items-center justify-center">
                  <Icon name={p.icon} class="w-5 h-5 text-sky-600" />
                </div>
                {p.tag && <span class="text-xs font-semibold text-sky-700 bg-sky-50 rounded-full px-2 py-0.5">{p.tag}</span>}
              </div>
              <h3 class="text-base font-bold text-slate-900 mb-1">{p.name}</h3>
              <p class="text-sm text-slate-600 leading-relaxed flex-1">{p.description}</p>
              <div class="mt-4 pt-4 border-t border-slate-100 flex items-baseline justify-between">
                <div class="flex items-baseline gap-2">
                  <span class="text-lg font-bold text-slate-900">{p.price}</span>
                  {p.oldPrice && <span class="text-sm text-slate-400 line-through">{p.oldPrice}</span>}
                </div>
                <span class="text-sm font-semibold text-sky-600 group-hover:text-sky-700 flex items-center gap-1">View<Icon name="chevronRight" class="w-4 h-4" /></span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  )}

  <div class="bg-white py-16 lg:py-24">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-3xl font-bold text-slate-900 tracking-tight">Suggested study plan and timeline</h2>
        <p class="mt-3 text-slate-600">A phased plan used by recent passers. Adjust to your own runway.</p>
      </div>
      <ol class="space-y-4">
        {examData.timeline.map((phase, i) => (
          <li class="flex gap-4 rounded-2xl border border-slate-200 bg-slate-50 p-5">
            <div class="shrink-0 w-10 h-10 rounded-full bg-sky-600 text-white flex items-center justify-center font-bold">{i + 1}</div>
            <div>
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-1">
                <h3 class="text-lg font-bold text-slate-900">{phase.phase}</h3>
                <span class="text-xs font-medium text-sky-700">{phase.weeks}</span>
              </div>
              <p class="text-sm text-slate-600 leading-relaxed">{phase.focus}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>

  <div class="bg-slate-50 py-16 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-10">
        <div>
          <h2 class="text-2xl font-bold text-slate-900 mb-5">Common pitfalls</h2>
          <ul class="space-y-3">
            {examData.pitfalls.map(p => (
              <li class="flex items-start gap-3 rounded-xl bg-white border border-slate-200 p-4">
                <div class="w-6 h-6 rounded-full bg-red-50 flex items-center justify-center shrink-0 mt-0.5">
                  <span class="text-red-600 font-bold text-sm">!</span>
                </div>
                <span class="text-sm text-slate-700">{p}</span>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h2 class="text-2xl font-bold text-slate-900 mb-5">Pro tips from recent passers</h2>
          <ul class="space-y-3">
            {examData.tips.map(t => (
              <li class="flex items-start gap-3 rounded-xl bg-white border border-slate-200 p-4">
                <div class="w-6 h-6 rounded-full bg-emerald-50 flex items-center justify-center shrink-0 mt-0.5">
                  <Icon name="check" class="w-3.5 h-3.5 text-emerald-600" />
                </div>
                <span class="text-sm text-slate-700">{t}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>

  <div class="bg-white py-16 lg:py-24">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-3xl font-bold text-slate-900 tracking-tight">Recommended textbooks and references</h2>
        <p class="mt-3 text-slate-600">The references the exam is actually written from.</p>
      </div>
      <div class="grid sm:grid-cols-2 gap-5">
        {examData.textbooks.map(b => (
          <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
            <div class="flex items-start gap-3">
              <div class="w-10 h-10 rounded-lg bg-sky-50 flex items-center justify-center shrink-0">
                <Icon name="bookOpen" class="w-5 h-5 text-sky-600" />
              </div>
              <div>
                <h3 class="text-base font-bold text-slate-900">{b.title}</h3>
                <p class="text-sm text-slate-600 mt-1">{b.why}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
      <div class="mt-8 rounded-2xl bg-sky-50 border border-sky-100 p-6">
        <h3 class="text-base font-bold text-slate-900 mb-2">Past papers and question patterns</h3>
        <p class="text-sm text-slate-700">{examData.pastPapers}</p>
      </div>
    </div>
  </div>

  {matchedTestimonials.length > 0 && (
    <div class="bg-slate-50 py-16 lg:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-12">
          <h2 class="text-3xl font-bold text-slate-900 tracking-tight">From doctors who passed {exam.name}</h2>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {matchedTestimonials.map(t => (
            <figure class="rounded-2xl border border-slate-200 bg-white p-6">
              <div class="flex gap-1 mb-3">
                {[0, 1, 2, 3, 4].map(() => (
                  <Icon name="star" class="w-4 h-4 text-amber-400" />
                ))}
              </div>
              <blockquote class="text-sm text-slate-700 leading-relaxed">"{t.text}"</blockquote>
              <figcaption class="mt-4 pt-4 border-t border-slate-100">
                <div class="text-sm font-semibold text-slate-900">{t.name}</div>
                <div class="text-xs text-slate-500">{t.role}</div>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </div>
  )}

  <div class="bg-white py-16 lg:py-24">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="text-3xl font-bold text-slate-900 tracking-tight">{exam.name} FAQ</h2>
        <p class="mt-3 text-slate-600">Answers to the questions residents actually ask.</p>
      </div>
      <div class="space-y-4">
        {examData.faqs.map(faq => (
          <details class="group rounded-xl border border-slate-200 bg-white open:shadow-sm transition-all">
            <summary class="flex cursor-pointer items-center justify-between p-5 text-left">
              <span class="text-base font-semibold text-slate-900 pr-4">{faq.q}</span>
              <span class="shrink-0 text-slate-400 group-open:rotate-180 transition-transform">
                <Icon name="chevronDown" class="w-5 h-5" />
              </span>
            </summary>
            <div class="px-5 pb-5 text-sm text-slate-600 leading-relaxed">{faq.a}</div>
          </details>
        ))}
      </div>
      <div class="mt-10 grid sm:grid-cols-3 gap-3 text-center text-sm">
        <a href="/exams" class="rounded-xl border border-slate-200 p-3 hover:border-sky-300 transition-colors text-slate-700 font-medium">All exams</a>
        <a href="/topics" class="rounded-xl border border-slate-200 p-3 hover:border-sky-300 transition-colors text-slate-700 font-medium">All topics</a>
        <a href="/glossary" class="rounded-xl border border-slate-200 p-3 hover:border-sky-300 transition-colors text-slate-700 font-medium">Glossary</a>
      </div>
    </div>
  </div>

  <FinalCTA />
</Layout>
