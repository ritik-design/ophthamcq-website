---
import Layout from '../../layouts/Layout.astro';
import { EXAMS, PRODUCTS, TESTIMONIALS } from '../../config';
import Icon from '../../components/Icon.astro';
import FinalCTA from '../../components/sections/FinalCTA.astro';

export function getStaticPaths() {
  return EXAMS.map(e => ({ params: { slug: e.slug } }));
}

const { slug } = Astro.params;
const exam = EXAMS.find(e => e.slug === slug);

if (!exam) {
  return Astro.redirect('/exams');
}

type ExamContent = {
  seoTitle: string;
  seoDescription: string;
  parts: { name: string; format: string; duration: string; passMark: string; questions: string }[];
  highYieldTopics: { heading: string; items: string[] }[];
  productIds: string[];
  timeline: { phase: string; weeks: string; focus: string }[];
  pitfalls: string[];
  tips: string[];
  textbooks: { title: string; why: string }[];
  pastPapers: string;
  testimonialFilter: string[];
  faqs: { q: string; a: string }[];
};

