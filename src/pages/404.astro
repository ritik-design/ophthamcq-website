---
import Layout from '../layouts/Layout.astro';
import Illustration from '../components/Illustration.astro';
---

<Layout title="Page Not Found" description="The page you are looking for does not exist.">
  <div class="flex flex-col items-center justify-center min-h-[60vh] px-4 text-center">
    <div class="w-48 h-48 rounded-2xl bg-sky-50 flex items-center justify-center mb-6">
      <Illustration name="hero" class="w-32 h-32" />
    </div>
    <h1 class="text-6xl font-extrabold text-slate-900 tracking-tight">404</h1>
    <p class="mt-4 text-xl text-slate-600">Page not found</p>
    <p class="mt-2 text-slate-500">The page you are looking for doesn't exist or has been moved.</p>
    <a href="/" class="mt-8 inline-flex items-center rounded-xl bg-sky-600 px-6 py-3 text-sm font-semibold text-white hover:bg-sky-700 transition-colors">
      Go Home
    </a>
  </div>
</Layout>