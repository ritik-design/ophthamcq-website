---
import Layout from '../layouts/Layout.astro';
import CategoryCard from '../components/CategoryCard.astro';
import PageHero from '../components/PageHero.astro';
import { CATEGORIES } from '../data/categories';
---

<Layout
  title="Free Ophthalmology MCQs by Exam — Practice & Buy Full Courses"
  description="Try free sample MCQs for PD-CET, FAICO, ICO/FICO, FRCOphth, Fellowship, Exam Notes, and High-Yield topics. Unlock full courses with handwritten notes and past papers."
>
  <PageHero
    eyebrow="100% Free — No Signup — Instant Scoring"
    eyebrowIcon="sparkles"
    accent="emerald"
    titleHtml={`Free <span class="text-sky-600">Ophthalmology MCQs</span> by Exam`}
    description="Pick your exam or topic, answer a short sample quiz, then unlock the full course with notes, past papers, and thousands of MCQs."
    primaryCta={{ href: '#categories', label: 'Choose a category' }}
    secondaryCta={{ href: '/notes', label: 'Browse notes' }}
    trust={[
      { value: '200+', label: 'Free MCQs' },
      { value: `${CATEGORIES.length}`, label: 'Categories' },
      { value: '0 ₹', label: 'To start' },
    ]}
    illustration="freeMcqs"
    floatLabel="Instant scoring"
    floatSub="No account needed"
    floatIcon="check"
  />
  <div id="categories" class="sr-only" aria-hidden="true"></div>

  <!-- Category selection -->
  <div class="bg-slate-50 py-12 lg:py-16 min-h-[60vh]">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {CATEGORIES.map((category) => (
          <CategoryCard category={category} />
        ))}
      </div>
    </div>
  </div>
</Layout>
