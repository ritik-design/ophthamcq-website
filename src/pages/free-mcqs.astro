---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Illustration from '../components/Illustration.astro';
import FinalCTA from '../components/sections/FinalCTA.astro';
---

<Layout
  title="Free Ophthalmology MCQs — Practice 50 Questions"
  description="Practice 50 free ophthalmology MCQs across all subspecialties. Instant scoring. Detailed explanations. No signup required."
>
  <div class="bg-white border-b border-slate-200">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div class="text-center lg:text-left">
          <div class="inline-flex items-center gap-2 rounded-full bg-emerald-50 border border-emerald-100 px-4 py-1.5 mb-6">
            <span class="text-sm font-medium text-emerald-700">100% Free — No Signup Required</span>
          </div>
          <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 tracking-tight">
            Free <span class="text-sky-600">Ophthalmology MCQs</span>
          </h1>
          <p class="mt-5 text-lg text-slate-600 max-w-xl mx-auto lg:mx-0">
            50 questions across Glaucoma, Retina, Cornea, Neuro, and more.
            Instant scoring. Detailed explanations. Zero commitment.
          </p>
        </div>
        <div class="flex justify-center">
          <div class="w-56 h-56 rounded-2xl bg-sky-50 flex items-center justify-center">
            <Illustration name="freeMcqs" class="w-40 h-40" />
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="bg-slate-50 py-16 lg:py-24">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <div class="rounded-2xl bg-white border border-slate-200 shadow-sm overflow-hidden">
        <div class="bg-sky-600 px-6 py-4 flex items-center justify-between">
          <span class="text-white font-bold">Question 1 of 50</span>
          <span class="text-sky-100 text-sm">Timer: 29:45</span>
        </div>

        <div class="p-6 lg:p-8">
          <p class="text-lg font-medium text-slate-900 mb-6">
            A 65-year-old diabetic patient presents with sudden painless loss of vision in the right eye.
            Fundus examination reveals dot-blot hemorrhages, hard exudates in a circinate pattern around the macula,
            and neovascularization at the optic disc. What is the most appropriate next step?
          </p>

          <div class="space-y-3">
            {[
              'A. Intravitreal anti-VEGF injection',
              'B. Pan-retinal photocoagulation (PRP)',
              'C. Focal laser photocoagulation',
              'D. Pars plana vitrectomy',
              'E. Observation with strict glycemic control',
            ].map(opt => (
              <button class="w-full text-left rounded-xl border-2 border-slate-200 px-5 py-4 text-sm text-slate-700 hover:border-sky-300 hover:bg-sky-50 transition-colors">
                {opt}
              </button>
            ))}
          </div>

          <div class="mt-8 flex items-center justify-between">
            <button class="text-sm text-slate-500 hover:text-slate-700">← Previous</button>
            <button class="inline-flex items-center rounded-xl bg-sky-600 px-6 py-2.5 text-sm font-semibold text-white hover:bg-sky-700 transition-colors">
              Submit Answer →
            </button>
          </div>
        </div>
      </div>

      <div class="mt-8 text-center">
        <p class="text-sm text-slate-500 mb-4">
          This is a preview. Complete the quiz to unlock detailed explanations and your performance report.
        </p>
        <a href="/notes" class="inline-flex items-center gap-2 rounded-xl bg-sky-600 px-6 py-3 text-sm font-semibold text-white hover:bg-sky-700 transition-colors">
          Unlock 10,000+ MCQs →
        </a>
      </div>
    </div>
  </div>

  <FinalCTA />
</Layout>