---
import Layout from '../layouts/Layout.astro';
import { TESTIMONIALS, PRODUCTS, EXAMS } from '../config';
import Icon from '../components/Icon.astro';
import Illustration from '../components/Illustration.astro';
import PageHero from '../components/PageHero.astro';
import FinalCTA from '../components/sections/FinalCTA.astro';

const stats = [
  { value: '15,000+', label: 'Ophthalmology residents helped to date' },
  { value: '+22%', label: 'Average mock exam score uplift after 8 weeks' },
  { value: '83%', label: 'Of OphthaMCQ subscribers cleared on first attempt' },
  { value: '7', label: 'PG exams supported — FRCOphth, ICO, FAICO, DNB, NEET-SS, PD-CET, OKAPs' },
];

const examGroups = [
  {
    name: 'FRCOphth — Royal College of Ophthalmologists',
    slug: 'frcophth',
    summary: 'FRCOphth Part 1 demands deep basic sciences; Part 2 rewards clinical pattern recognition and OSCE polish. Our FRCOphth toppers all share two habits: daily basic-sciences MCQs and weekly past-paper reviews from Part 1 onwards.',
    matchKeys: ['frcophth'],
    narrative: 'The candidates below sat FRCOphth from India, the UK and the Middle East. Most cleared Part 1 in 6–9 months of structured prep using our optics, anatomy and physiology MCQs alongside the handwritten note bundle.',
  },
  {
    name: 'ICO / FICO — International Council of Ophthalmology',
    slug: 'ico-fico',
    summary: 'ICO Basic Sciences is heavy on visual physiology, optics and pathology. ICO/FICO clinical papers favour algorithm-based decision making. The right past-paper bank is the single biggest score multiplier.',
    matchKeys: ['ico'],
    narrative: 'ICO candidates we hear from typically prepare alongside their day-job residency. The most successful pattern is 60–90 minutes of MCQ practice on weekdays and a half-day past-paper attempt on weekends.',
  },
  {
    name: 'FAICO — Fellowship of All India Ophthalmological Society',
    slug: 'faico',
    summary: 'FAICO is subspecialty-deep. Retina, Glaucoma and Oculoplastics fellows all need different note bundles and MCQ tracks. Generic MCQ banks underperform here — syllabus-mapped questions matter.',
    matchKeys: ['faico'],
    narrative: 'Our FAICO toppers commonly come from Aravind, Sankara Nethralaya, LV Prasad and similar high-volume centres. They use OphthaMCQ for the targeted syllabus mapping that internal teaching alone does not provide.',
  },
  {
    name: 'DNB Ophthalmology — Diplomate of National Board',
    slug: 'dnb',
    summary: 'DNB theory papers are wide and shallow; the practical and viva are unforgiving. Most failures we see at DNB are due to under-revising paper one (basic sciences) and over-relying on Khurana for paper four.',
    matchKeys: ['dnb'],
    narrative: 'DNB candidates who clear in first attempt overwhelmingly follow the same path: handwritten notes for first-pass coverage, then 1,500–2,000 MCQs per month for the last 8 weeks, then daily past-paper attempts in the final fortnight.',
  },
  {
    name: 'NEET-SS Ophthalmology — Super Speciality Entrance',
    slug: 'neet-ss',
    summary: 'NEET-SS is competitive. The cut-off for a Retina or Glaucoma seat is a fraction of a percentile away from being too low. Our toppers focused on Retina Deciphered plus targeted high-yield MCQs.',
    matchKeys: ['neet-ss'],
    narrative: 'NEET-SS candidates we have helped landed seats at AIIMS, JIPMER and major private super-speciality programmes. The common factor: starting subspecialty deep-dive at least 6 months before the exam.',
  },
];

const topperPatterns = [
  { title: 'Daily, not heroic', desc: 'Every topper we surveyed practised MCQs daily for at least 60 minutes. Nobody passed by binge-studying weekends only.' },
  { title: 'Mistakes log', desc: 'Successful candidates keep a one-page log of MCQs they got wrong and re-attempt them weekly until accuracy hits 100%.' },
  { title: 'Past papers early', desc: 'Toppers start past-paper attempts at week 2 of prep, not week 10. Early exposure normalises the exam format before nerves set in.' },
  { title: 'Handwritten notes, not retyped', desc: 'They use ready-made handwritten notes for revision and only handwrite their own additions. Re-typing notes is among the lowest-yield activities.' },
  { title: 'Two-pass image practice', desc: 'Every topper did image-based MCQs at least twice — once early, once in the final two weeks. Fundus and OCT pattern recognition needs spaced repetition.' },
  { title: 'No solo prep', desc: 'They had a study partner, a Telegram group, or weekly tutorials. Solo prep correlates strongly with under-performance in our data.' },
];

const videoStories = [
  { name: 'Dr. R. Banerjee', exam: 'DNB Ophthalmology', label: 'How I cleared DNB theory in first attempt' },
  { name: 'Dr. A. Hassan', exam: 'FRCOphth Part 1', label: 'Optics is not the enemy — a FRCOphth walkthrough' },
  { name: 'Dr. M. Iyer', exam: 'NEET-SS Retina', label: 'Six months from idea to retina seat' },
];

const successFaq = [
  { q: 'How long did successful candidates typically prepare?', a: 'FRCOphth Part 1 toppers average 6–9 months. DNB final candidates average 4–6 months of focused prep on top of their three-year residency teaching. FAICO and NEET-SS toppers usually begin focused prep 6 months out, with subspecialty reading starting earlier.' },
  { q: 'Did most toppers use only OphthaMCQ?', a: 'No. Almost all of them paired OphthaMCQ with at least one standard textbook (Kanski or BCSC) and one set of past papers. The combination is the point — no single resource is sufficient on its own.' },
  { q: 'What percentage of subscribers actually pass first time?', a: 'In our own polling, roughly 83% of paid subscribers who completed at least 70% of their target MCQ track cleared first attempt. Subscribers who used less than 30% of the material had much closer to baseline pass rates.' },
  { q: 'Are these testimonials verifiable?', a: 'Yes. Every quote shown on this page is from a real candidate and is on file with their permission. We can share verification details to genuine institutional or media enquiries on request.' },
  { q: 'How can I share my own success story?', a: 'We love hearing from candidates who passed using OphthaMCQ. Email us or use the contact form and we will feature your story (anonymously if you prefer).' },
];

const relatedProducts = PRODUCTS.slice(0, 4);
---

<Layout
  title="Ophthalmology Exam Success Stories — Passed FRCOphth, ICO, FAICO, DNB"
  description="Real testimonials and reviews from ophthalmology residents who cleared FRCOphth, ICO/FICO, FAICO, DNB and NEET-SS using OphthaMCQ. Read how they passed on first attempt."
>
  <PageHero
    eyebrow="Real doctors. Real exams. Real passes."
    eyebrowIcon="trophy"
    accent="emerald"
    titleHtml={`Ophthalmology Exam <span class="text-sky-600">Success Stories</span>`}
    description="How residents passed FRCOphth, ICO/FICO, FAICO, DNB and NEET-SS using OphthaMCQ — what worked, what they wish they had done differently, and what topped their study stack."
    primaryCta={{ href: '/free-mcqs', label: 'Start free practice' }}
    secondaryCta={{ href: '/notes', label: 'Browse notes' }}
    trust={[
      { value: '15k+', label: 'Residents' },
      { value: '83%', label: 'First pass' },
      { value: '7', label: 'Exams' },
    ]}
    illustration="success"
    floatLabel="First-attempt stories"
    floatSub="From real passers"
    floatIcon="trophy"
  />

  <section class="bg-slate-900 py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {stats.map(s => (
          <div class="text-center">
            <div class="text-4xl sm:text-5xl font-extrabold text-sky-300">{s.value}</div>
            <p class="mt-3 text-sm text-slate-300 leading-relaxed">{s.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {examGroups.map((group, idx) => {
    const groupTestimonials = TESTIMONIALS.filter(t =>
      group.matchKeys.some(k => t.exam.toLowerCase().includes(k))
    );
    if (groupTestimonials.length === 0) return null;
    return (
      <section class={idx % 2 === 0 ? 'bg-white py-16 lg:py-24' : 'bg-slate-50 py-16 lg:py-24'}>
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <div class="max-w-3xl mb-8">
            <div class="inline-flex items-center gap-2 rounded-full bg-sky-50 border border-sky-100 px-3 py-1 mb-3">
              <span class="text-xs font-semibold text-sky-700 uppercase tracking-wide">{group.name.split(' — ')[0]}</span>
            </div>
            <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 tracking-tight">{group.name}</h2>
            <p class="mt-4 text-base text-slate-700">{group.summary}</p>
            <p class="mt-3 text-sm text-slate-600 italic">{group.narrative}</p>
          </div>
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
            {groupTestimonials.map(t => (
              <div class="rounded-2xl bg-white border border-slate-200 p-6 hover:shadow-lg hover:border-sky-200 transition-all">
                <div class="flex items-center gap-1 mb-4">
                  {[1,2,3,4,5].map(() => (
                    <Icon name="star" class="w-4 h-4 text-amber-400" />
                  ))}
                </div>
                <blockquote class="text-base text-slate-700 italic mb-5 leading-relaxed">"{t.text}"</blockquote>
                <div class="flex items-center gap-3 pt-4 border-t border-slate-100">
                  <div class="h-10 w-10 rounded-full bg-sky-100 flex items-center justify-center text-sky-700 font-bold">
                    {t.name.charAt(0)}
                  </div>
                  <div class="flex-1">
                    <div class="font-semibold text-slate-900 text-sm">{t.name}</div>
                    <div class="text-xs text-slate-500">{t.role}</div>
                  </div>
                  <span class="inline-flex items-center rounded-full bg-sky-50 px-2.5 py-1 text-xs font-medium text-sky-700">{t.exam}</span>
                </div>
              </div>
            ))}
          </div>
          <div class="mt-8">
            <a href={`/exams/${group.slug}`} class="inline-flex items-center gap-1 text-sm font-semibold text-sky-700 hover:text-sky-800">
              See the {group.name.split(' — ')[0]} exam guide
              <Icon name="chevronRight" class="w-4 h-4" />
            </a>
          </div>
        </div>
      </section>
    );
  })}

  <section class="bg-white py-16 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 tracking-tight">Common patterns we see in toppers</h2>
        <p class="mt-4 text-lg text-slate-600">
          Six habits that show up again and again in candidates who clear first attempt — across FRCOphth, DNB and FAICO.
        </p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {topperPatterns.map(p => (
          <div class="rounded-2xl bg-slate-50 border border-slate-200 p-6">
            <div class="w-10 h-10 rounded-lg bg-sky-100 flex items-center justify-center mb-3">
              <Icon name="check" class="w-5 h-5 text-sky-700" />
            </div>
            <h3 class="font-bold text-slate-900 mb-2">{p.title}</h3>
            <p class="text-sm text-slate-600 leading-relaxed">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-slate-50 py-16 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 tracking-tight">Video testimonials</h2>
        <p class="mt-4 text-lg text-slate-600">
          Long-form video stories from our most recent passers. Coming soon — recordings in production.
        </p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {videoStories.map(v => (
          <div class="rounded-2xl border border-slate-200 bg-white overflow-hidden">
            <div class="aspect-video bg-gradient-to-br from-sky-100 to-slate-200 flex items-center justify-center relative">
              <div class="w-16 h-16 rounded-full bg-white/90 flex items-center justify-center shadow-md">
                <Icon name="play" class="w-7 h-7 text-sky-600" />
              </div>
              <div class="absolute bottom-3 left-3 right-3 inline-flex items-center gap-2 rounded-full bg-slate-900/80 px-3 py-1 text-xs font-semibold text-white w-fit">
                Video coming soon
              </div>
            </div>
            <div class="p-5">
              <div class="text-xs font-semibold text-sky-700 uppercase tracking-wide">{v.exam}</div>
              <h3 class="mt-1 font-bold text-slate-900">{v.label}</h3>
              <p class="mt-2 text-sm text-slate-500">{v.name}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-sky-600 py-16 lg:py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight">Cleared your exam with OphthaMCQ?</h2>
      <p class="mt-4 text-lg text-sky-100 max-w-2xl mx-auto">
        We would love to feature your story. Tell us what worked, what didn't, and what advice you would give the next cohort.
        Anonymous submissions welcome.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/contact" class="inline-flex items-center justify-center gap-2 rounded-xl bg-white px-6 py-3 text-sm font-semibold text-sky-700 hover:bg-sky-50 transition-colors">
          Share Your Story
          <Icon name="arrowRight" class="w-4 h-4" />
        </a>
        <a href="/free-mcqs" class="inline-flex items-center justify-center gap-2 rounded-xl border-2 border-white/30 px-6 py-3 text-sm font-semibold text-white hover:bg-white/10 transition-colors">
          Try Free MCQs
        </a>
      </div>
    </div>
  </section>

  <section class="bg-white py-16 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 tracking-tight">What our passers used</h2>
        <p class="mt-4 text-lg text-slate-600">
          The four products that show up most often in the study stacks of residents who cleared first attempt.
        </p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {relatedProducts.map(p => (
          <div class="group relative flex flex-col rounded-2xl border border-slate-200 bg-white overflow-hidden hover:shadow-lg hover:border-sky-200 transition-all duration-300">
            {p.tag && (
              <div class="absolute top-3 left-3 z-10">
                <span class="inline-flex items-center rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-semibold text-amber-800">
                  {p.tag}
                </span>
              </div>
            )}
            <div class="h-44 bg-slate-100 overflow-hidden">
              <img src={p.image} alt={p.fullName} loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
            </div>
            <div class="flex flex-col flex-1 p-5">
              <h3 class="text-base font-bold text-slate-900 mb-1">{p.name}</h3>
              <p class="text-sm text-slate-600 mb-4 flex-1 leading-relaxed">{p.description}</p>
              <div class="flex items-baseline gap-2 mb-4">
                <span class="text-xl font-bold text-slate-900">{p.price}</span>
                {p.oldPrice && <span class="text-sm text-slate-400 line-through">{p.oldPrice}</span>}
              </div>
              <a href={p.href} target="_blank" rel="noopener noreferrer" class="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-sky-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-sky-700 transition-colors">
                View on Store
                <Icon name="externalLink" class="w-4 h-4" />
              </a>
            </div>
          </div>
        ))}
      </div>
      <div class="mt-10 text-center">
        <a href="/notes" class="inline-flex items-center gap-2 rounded-xl bg-white px-6 py-3 text-sm font-semibold text-slate-700 border-2 border-slate-200 hover:border-sky-300 hover:text-sky-700 transition-all">
          Browse all notes & MCQ products
          <Icon name="chevronRight" class="w-4 h-4" />
        </a>
      </div>
    </div>
  </section>

  <section class="bg-slate-50 py-16 lg:py-24">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 tracking-tight">Success stories — frequently asked questions</h2>
        <p class="mt-4 text-lg text-slate-600">What candidates ask after reading our reviews.</p>
      </div>
      <div class="space-y-4">
        {successFaq.map(faq => (
          <details class="group rounded-xl border border-slate-200 bg-white open:shadow-sm transition-all">
            <summary class="flex cursor-pointer items-center justify-between p-5 text-left">
              <span class="text-base font-semibold text-slate-900 pr-4">{faq.q}</span>
              <span class="shrink-0 text-slate-400 group-open:rotate-180 transition-transform">
                <Icon name="chevronDown" class="w-5 h-5" />
              </span>
            </summary>
            <div class="px-5 pb-5 text-sm text-slate-600 leading-relaxed">{faq.a}</div>
          </details>
        ))}
      </div>
      <div class="mt-10 grid sm:grid-cols-3 gap-4 text-center">
        <a href="/resources" class="rounded-xl border border-slate-200 bg-white px-5 py-4 text-sm font-semibold text-slate-700 hover:border-sky-300 hover:text-sky-700 transition-all">Free Resources</a>
        <a href="/exams" class="rounded-xl border border-slate-200 bg-white px-5 py-4 text-sm font-semibold text-slate-700 hover:border-sky-300 hover:text-sky-700 transition-all">Exam Guides</a>
        <a href="/contact" class="rounded-xl border border-slate-200 bg-white px-5 py-4 text-sm font-semibold text-slate-700 hover:border-sky-300 hover:text-sky-700 transition-all">Share Your Story</a>
      </div>
    </div>
  </section>

  <FinalCTA />
</Layout>
