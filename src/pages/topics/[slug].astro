  uveitis: {
    name: 'Uveitis',
    questionCount: '300+',
    glossaryCategory: 'Uveitis',
    mcqTopic: 'Uveitis',
    productIds: ['high-yield-mcqs', 'anatomy-notes'],
    relatedExams: [{ slug: 'frcophth', name: 'FRCOphth' }, { slug: 'dnb', name: 'DNB' }, { slug: 'faico', name: 'FAICO' }, { slug: 'ico-fico', name: 'ICO/FICO' }],
    seoTitle: 'Uveitis MCQs & Study Guide — Classification, Workup, Treatment',
    seoDescription: 'Uveitis study guide for ophthalmology PG exams. 300+ MCQs on anterior, intermediate, posterior, panuveitis, infectious vs autoimmune workup and treatment.',
    overview: 'Uveitis is a heterogeneous group of inflammatory eye diseases that requires structured anatomical classification (SUN), targeted systemic workup, and a step-wise treatment ladder. It accounts for 10% of legal blindness in working-age adults.',
    clinicalImportance: 'Uveitis tests pattern recognition heavily. FAICO and DNB practical vivas use clinical photographs of KPs, posterior synechiae and chorioretinal lesions to anchor case discussions.',
    anatomyRefresher: [
      'Uveal tract: iris, ciliary body, choroid.',
      'Blood–aqueous barrier formed by non-pigmented ciliary epithelium and iris vasculature.',
      'Blood–retinal barrier formed by RPE tight junctions and retinal vascular endothelium.',
      'Choroid is the most vascular tissue in the body per unit weight.',
      'HLA associations: HLA-B27 (acute anterior uveitis), HLA-A29 (birdshot), HLA-B51 (Behçet).',
    ],
    highYieldFacts: [
      'SUN classification by anatomy: anterior, intermediate, posterior, panuveitis.',
      'Acute anterior uveitis (AAU): pain, photophobia, redness, miosis; HLA-B27 in 50%.',
      'HLA-B27 associated systemic diseases: ankylosing spondylitis, reactive arthritis, IBD, psoriatic arthritis.',
      'Fuchs heterochromic iridocyclitis: unilateral, mild inflammation, stellate KPs, heterochromia, cataract; rubella linked.',
      'Pars planitis: intermediate uveitis with vitreous snowballs and inferior snowbanking; MS association.',
      'Toxoplasma retinitis: focal necrotising chorioretinitis adjacent to a pigmented scar; treat with TMP-SMX or pyrimethamine-sulfadiazine.',
      'CMV retinitis: AIDS-defining, pizza-pie appearance, treat with ganciclovir.',
      'Acute retinal necrosis: VZV/HSV, peripheral confluent necrosis; treat with IV aciclovir.',
      'VKH: bilateral panuveitis with neurological and dermatological signs; serous RD on OCT.',
      'Sympathetic ophthalmia: bilateral granulomatous uveitis after penetrating injury or surgery; Dalen-Fuchs nodules.',
      'Behçet disease: occlusive retinal vasculitis, hypopyon uveitis, oral and genital ulcers, pathergy.',
      'Birdshot chorioretinopathy: HLA-A29, cream-coloured deep choroidal lesions, female predominance.',
      'Sarcoid uveitis: mutton-fat KPs, candle-wax dripping, raised ACE; bilateral hilar lymphadenopathy.',
      'Treatment ladder: topical/periocular steroids → systemic steroids → steroid-sparing immunosuppressants → biologics (adalimumab).',
      'Complications of chronic uveitis: cataract, glaucoma, CME, band keratopathy, hypotony.',
