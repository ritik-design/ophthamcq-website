    studySequence: [
      { step: '1. Lid anatomy and physiology', detail: 'Layers, retractors, blood supply, innervation.' },
      { step: '2. Lid malpositions', detail: 'Ptosis, entropion, ectropion, lagophthalmos with surgical algorithms.' },
      { step: '3. Lid lesions and tumours', detail: 'Benign vs malignant pattern recognition, biopsy and Mohs.' },
      { step: '4. Lacrimal disease', detail: 'Drainage anatomy, dacryocystitis, DCR techniques.' },
      { step: '5. Orbital disease', detail: 'Thyroid eye disease, idiopathic orbital inflammation, cellulitis, tumours.' },
      { step: '6. Trauma and reconstruction', detail: 'Lid laceration, blowout fracture, anophthalmic socket management.' },
    ],
    sampleQuestion: 'What is the most common malignant eyelid tumor?',
    sampleAnswer: 'Basal cell carcinoma (>90% of eyelid malignancies), typically a pearly nodule with telangiectasia on the lower lid or medial canthus.',
    faqs: [
      { q: 'When to operate on congenital ptosis?', a: 'If amblyogenic (covering visual axis or causing astigmatism), operate early. Otherwise, school age before social impact.' },
      { q: 'Best procedure for severe ptosis with poor levator function?', a: 'Frontalis sling using autologous fascia lata, silicone or expanded PTFE.' },
      { q: 'When is DCR indicated?', a: 'Symptomatic nasolacrimal duct obstruction confirmed by syringing; chronic dacryocystitis.' },
      { q: 'How to manage active thyroid eye disease?', a: 'Smoking cessation, lubrication, selenium, IV pulse methylprednisolone for moderate-severe active disease; teprotumumab where available; surgery in inactive phase.' },
      { q: 'Recommended oculoplastics book?', a: 'Nesi Smith Oculoplastic Surgery; Stewart Atlas of Aesthetic Eyelid and Periocular Surgery; our handwritten Eyelids Notes for revision.' },
