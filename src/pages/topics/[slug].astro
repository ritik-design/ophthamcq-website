const topic = topics[slug!] ?? topics.glaucoma;

const topicBundleMap: Record<string, CategoryId[]> = {
  glaucoma: ['pdcet', 'faico', 'high-yield', 'general'],
  retina: ['faico', 'high-yield', 'general'],
  cornea: ['general', 'high-yield'],
  cataract: ['general', 'high-yield'],
  'neuro-ophthalmology': ['general', 'high-yield'],
  'pediatric-ophthalmology': ['faico', 'high-yield'],
  uveitis: ['general', 'high-yield'],
  oculoplastics: ['pdcet', 'high-yield', 'general'],
};

const topicBundles = topicBundleMap[slug!] ?? [];

const matchedProducts = topic.productIds
  .map(id => PRODUCTS.find(p => p.id === id))
  .filter((p): p is typeof PRODUCTS[number] => Boolean(p));

const glossaryTerms = GLOSSARY
  .filter(g => g.category === topic.glossaryCategory)
  .slice(0, 14);

const sampleMcqs = MCQS
  .filter(m => m.topic === topic.mcqTopic)
  .slice(0, 3);
---

<Layout
  title={topic.seoTitle}
  description={topic.seoDescription}
>
  <div class="site-hero bg-white border-b border-slate-200">
    <div class="site-hero-inner mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 sm:py-16 lg:py-10">
      <div class="grid lg:grid-cols-2 gap-8 sm:gap-12 items-center w-full">
        <div class="text-center lg:text-left">
          <div class="inline-flex items-center gap-2 rounded-full bg-sky-50 border border-sky-100 px-3 py-1 mb-6">
            <span class="text-sm font-medium text-sky-700">Topic Study Guide</span>
          </div>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight">
            {topic.name} <span class="text-sky-600">MCQs &amp; Guide</span>
          </h1>
          <p class="mt-5 text-base sm:text-lg text-slate-600 max-w-xl mx-auto lg:mx-0">
            {topic.questionCount} questions with detailed explanations. Master {topic.name.toLowerCase()} for FRCOphth, ICO, FAICO, DNB and NEET-SS.
          </p>
          <div class="mt-8 flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center lg:justify-start">
            <a href="/free-mcqs" class="inline-flex items-center justify-center rounded-xl bg-sky-600 px-6 py-3 text-sm font-semibold text-white hover:bg-sky-700 transition-colors w-full sm:w-auto">Try Free MCQs</a>
            <a href="/notes" class="inline-flex items-center justify-center rounded-xl bg-white px-6 py-3 text-sm font-semibold text-slate-700 border-2 border-slate-200 hover:border-sky-300 transition-colors w-full sm:w-auto">View Notes</a>
          </div>
        </div>
        <div class="flex justify-center">
          <div class="w-44 h-44 sm:w-56 sm:h-56 rounded-2xl bg-sky-50 flex items-center justify-center">
            <Illustration name="questionBank" class="w-32 h-32 sm:w-40 sm:h-40" />
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="bg-slate-50 py-16 lg:py-24">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-3 gap-8">
        <div class="lg:col-span-2">
          <h2 class="text-3xl font-bold text-slate-900 mb-4">{topic.name} overview</h2>
          <p class="text-slate-700 leading-relaxed mb-6">{topic.overview}</p>
          <h3 class="text-xl font-bold text-slate-900 mb-3">Clinical &amp; exam importance</h3>
          <p class="text-slate-700 leading-relaxed">{topic.clinicalImportance}</p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-6">
          <h3 class="text-base font-bold text-slate-900 mb-4">At a glance</h3>
          <dl class="space-y-3 text-sm">
            <div class="flex justify-between"><dt class="text-slate-500">MCQ bank</dt><dd class="font-semibold text-slate-900">{topic.questionCount}</dd></div>
            <div class="flex justify-between"><dt class="text-slate-500">Glossary terms</dt><dd class="font-semibold text-slate-900">{glossaryTerms.length}+</dd></div>
            <div class="flex justify-between"><dt class="text-slate-500">Free sample MCQs</dt><dd class="font-semibold text-slate-900">{sampleMcqs.length}</dd></div>
            <div class="flex justify-between"><dt class="text-slate-500">Matched products</dt><dd class="font-semibold text-slate-900">{matchedProducts.length}</dd></div>
          </dl>
          <a href={`/free-mcqs?topic=${encodeURIComponent(topic.mcqTopic)}`} class="mt-4 inline-flex w-full items-center justify-center rounded-xl bg-sky-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-sky-700 transition-colors">
            Practice {topic.name} MCQs
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="bg-white py-16 lg:py-24">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-slate-900 mb-3">Core anatomy &amp; physiology refresher</h2>
      <p class="text-slate-600 mb-8">The foundations you need before tackling clinical and surgical MCQs.</p>
      <ul class="grid sm:grid-cols-2 gap-4">
        {topic.anatomyRefresher.map(item => (
          <li class="flex items-start gap-3 rounded-2xl border border-slate-200 bg-slate-50 p-4">
            <Icon name="check" class="w-4 h-4 text-sky-600 mt-1 shrink-0" />
            <span class="text-sm text-slate-700 leading-relaxed">{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="bg-slate-50 py-16 lg:py-24">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-slate-900 mb-3">High-yield {topic.name.toLowerCase()} facts for MCQs</h2>
      <p class="text-slate-600 mb-8">The facts that appear most often in real exam stems. Learn them cold.</p>
      <ul class="space-y-3">
        {topic.highYieldFacts.map((fact, i) => (
          <li class="flex items-start gap-3 rounded-xl border border-slate-200 bg-white p-4">
            <div class="shrink-0 w-7 h-7 rounded-full bg-sky-50 text-sky-700 text-xs font-bold flex items-center justify-center">{i + 1}</div>
            <span class="text-sm text-slate-700 leading-relaxed">{fact}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  {glossaryTerms.length > 0 && (
    <div class="bg-white py-16 lg:py-24">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
          <div>
            <h2 class="text-3xl font-bold text-slate-900 mb-2">Related {topic.name.toLowerCase()} glossary terms</h2>
            <p class="text-slate-600">Exam-ready definitions filtered by subspecialty.</p>
          </div>
          <a href="/glossary" class="inline-flex items-center gap-1 text-sm font-semibold text-sky-700 hover:text-sky-800">
            Browse full 316-term glossary <Icon name="chevronRight" class="w-4 h-4" />
          </a>
        </div>
        <div class="grid sm:grid-cols-2 gap-4">
          {glossaryTerms.map(g => (
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
              <div class="font-semibold text-slate-900 mb-1">{g.term}</div>
              <div class="text-sm text-slate-600 leading-relaxed">{g.definition}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  )}

  {matchedProducts.length > 0 && (
    <div class="bg-slate-50 py-16 lg:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-12">
          <h2 class="text-3xl font-bold text-slate-900 tracking-tight">Matched products for {topic.name}</h2>
          <p class="mt-3 text-slate-600">Resources hand-picked for this subspecialty.</p>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {matchedProducts.map(p => (
            <a href={p.href} class="group flex flex-col rounded-2xl border border-slate-200 bg-white p-6 hover:shadow-lg hover:border-sky-200 transition-all">
              <div class="flex items-center gap-3 mb-3">
                <div class="w-10 h-10 rounded-lg bg-sky-50 flex items-center justify-center">
                  <Icon name={p.icon} class="w-5 h-5 text-sky-600" />
                </div>
                {p.tag && <span class="text-xs font-semibold text-sky-700 bg-sky-50 rounded-full px-2 py-0.5">{p.tag}</span>}
              </div>
              <h3 class="text-base font-bold text-slate-900 mb-1">{p.name}</h3>
              <p class="text-sm text-slate-600 leading-relaxed flex-1">{p.description}</p>
              <div class="mt-4 pt-4 border-t border-slate-100 flex items-baseline justify-between">
                <div class="flex items-baseline gap-2">
                  <span class="text-lg font-bold text-slate-900">{p.price}</span>
                  {p.oldPrice && <span class="text-sm text-slate-400 line-through">{p.oldPrice}</span>}
                </div>
                <span class="text-sm font-semibold text-sky-600 group-hover:text-sky-700 flex items-center gap-1">View<Icon name="chevronRight" class="w-4 h-4" /></span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  )}

  {topicBundles.length > 0 && (
    <div class="bg-white py-16 lg:py-24">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-12">
          <h2 class="text-3xl font-bold text-slate-900 tracking-tight">Or buy the complete bundle for your exam</h2>
          <p class="mt-3 text-slate-600">These exam bundles include {topic.name.toLowerCase()} plus all the other topics you need.</p>
        </div>
        <div class="space-y-8">
          {topicBundles.map((categoryId) => (
            <BundleCTA categoryId={categoryId} />
          ))}
        </div>
      </div>
    </div>
  )}

  <div class="bg-white py-16 lg:py-24">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-slate-900 mb-3">Suggested study sequence</h2>
      <p class="text-slate-600 mb-8">Six phases used by recent passers. Spread across 4–8 weeks per subspecialty.</p>
      <ol class="space-y-4">
        {topic.studySequence.map((s, i) => (
          <li class="flex gap-4 rounded-2xl border border-slate-200 bg-slate-50 p-5">
            <div class="shrink-0 w-10 h-10 rounded-full bg-sky-600 text-white flex items-center justify-center font-bold">{i + 1}</div>
            <div>
              <h3 class="text-lg font-bold text-slate-900 mb-1">{s.step}</h3>
              <p class="text-sm text-slate-600 leading-relaxed">{s.detail}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>

  {sampleMcqs.length > 0 && (
    <div class="bg-slate-50 py-16 lg:py-24">
      <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold text-slate-900 mb-3">Free {topic.name.toLowerCase()} sample MCQs</h2>
        <p class="text-slate-600 mb-8">A taste of the exam-style stems from the full bank.</p>
        <div class="space-y-4">
          {sampleMcqs.map((m, i) => (
            <details class="group rounded-2xl border border-slate-200 bg-white p-5 open:shadow-sm transition-all">
              <summary class="cursor-pointer text-base font-semibold text-slate-900 list-none">
                <span class="text-sky-600 mr-2">Q{i + 1}.</span>{m.q}
              </summary>
              <div class="mt-4 space-y-2">
                {m.options.map((opt, idx) => (
                  <div class={`text-sm rounded-lg px-3 py-2 border ${idx === m.correct ? 'border-emerald-200 bg-emerald-50 text-emerald-900 font-semibold' : 'border-slate-200 bg-slate-50 text-slate-700'}`}>
                    {String.fromCharCode(65 + idx)}. {opt}
                  </div>
                ))}
                <p class="mt-3 text-sm text-slate-600"><span class="font-semibold text-slate-900">Explanation: </span>{m.explanation}</p>
              </div>
            </details>
          ))}
        </div>
        <div class="mt-8 text-center">
          <a href="/free-mcqs" class="inline-flex items-center gap-2 rounded-xl bg-sky-600 px-6 py-3 text-sm font-semibold text-white hover:bg-sky-700 transition-colors">
            Try 50 free MCQs across all topics
            <Icon name="arrowRight" class="w-4 h-4" />
          </a>
        </div>
      </div>
    </div>
  )}

  <div class="bg-white py-16 lg:py-24">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="text-3xl font-bold text-slate-900 tracking-tight">{topic.name} FAQ</h2>
        <p class="mt-3 text-slate-600">Answers to the questions residents ask most about this topic.</p>
      </div>
      <div class="space-y-4">
        {topic.faqs.map(faq => (
          <details class="group rounded-xl border border-slate-200 bg-white open:shadow-sm transition-all">
            <summary class="flex cursor-pointer items-center justify-between p-5 text-left">
              <span class="text-base font-semibold text-slate-900 pr-4">{faq.q}</span>
              <span class="shrink-0 text-slate-400 group-open:rotate-180 transition-transform">
                <Icon name="chevronDown" class="w-5 h-5" />
              </span>
            </summary>
            <div class="px-5 pb-5 text-sm text-slate-600 leading-relaxed">{faq.a}</div>
          </details>
        ))}
      </div>
    </div>
  </div>

  <div class="bg-slate-50 py-16 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-3xl font-bold text-slate-900 tracking-tight">Continue your prep</h2>
        <p class="mt-3 text-slate-600">Jump to related exams, topics and resources.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <a href="/free-mcqs" class="rounded-2xl border border-slate-200 bg-white p-6 hover:border-sky-200 hover:shadow-md transition-all">
          <div class="w-10 h-10 rounded-lg bg-sky-50 flex items-center justify-center mb-3"><Icon name="mcq" class="w-5 h-5 text-sky-600" /></div>
          <h3 class="text-base font-bold text-slate-900 mb-1">Practice {topic.name} MCQs</h3>
          <p class="text-sm text-slate-600">Drill the full bank with instant scoring.</p>
        </a>
        <a href="/glossary" class="rounded-2xl border border-slate-200 bg-white p-6 hover:border-sky-200 hover:shadow-md transition-all">
          <div class="w-10 h-10 rounded-lg bg-sky-50 flex items-center justify-center mb-3"><Icon name="bookOpen" class="w-5 h-5 text-sky-600" /></div>
          <h3 class="text-base font-bold text-slate-900 mb-1">{topic.name} glossary</h3>
          <p class="text-sm text-slate-600">All terms in this subspecialty.</p>
        </a>
        <a href="/topics" class="rounded-2xl border border-slate-200 bg-white p-6 hover:border-sky-200 hover:shadow-md transition-all">
          <div class="w-10 h-10 rounded-lg bg-sky-50 flex items-center justify-center mb-3"><Illustration name="questionBank" class="w-6 h-6" /></div>
          <h3 class="text-base font-bold text-slate-900 mb-1">All topics</h3>
          <p class="text-sm text-slate-600">Switch to retina, cornea, glaucoma and more.</p>
        </a>
        <a href="/notes" class="rounded-2xl border border-slate-200 bg-white p-6 hover:border-sky-200 hover:shadow-md transition-all">
          <div class="w-10 h-10 rounded-lg bg-sky-50 flex items-center justify-center mb-3"><Icon name="notes" class="w-5 h-5 text-sky-600" /></div>
          <h3 class="text-base font-bold text-slate-900 mb-1">Handwritten notes</h3>
          <p class="text-sm text-slate-600">Per-topic notes from Kanski, Ryan and Elkington.</p>
        </a>
      </div>
      <div class="mt-10">
        <h3 class="text-lg font-bold text-slate-900 mb-4 text-center">Relevant exam pages</h3>
        <div class="flex flex-wrap justify-center gap-3">
          {topic.relatedExams.map(e => (
            <a href={`/exams/${e.slug}`} class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:border-sky-300 hover:text-sky-700 transition-colors">
              {e.name}
              <Icon name="chevronRight" class="w-4 h-4" />
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>

  <FinalCTA />
</Layout>
