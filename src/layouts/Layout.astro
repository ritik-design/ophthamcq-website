---
import '../styles/global.css';
import { SITE } from '../config';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GooglePreferredSource from '../components/GooglePreferredSource.astro';

export interface Breadcrumb {
  name: string;
  /** Omit on the final crumb — the current page needs no self-link. */
  href?: string;
}

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  robots?: string;
  ogType?: string;
  /** Trail after Home. Renders a BreadcrumbList node; Home is prepended here. */
  breadcrumbs?: Breadcrumb[];
  /** Extra JSON-LD nodes (Product, FAQPage, Article…) merged into the @graph. */
  schema?: Record<string, unknown>[];
}

const {
  title = SITE.name,
  description = SITE.description,
  image = '/og-image.jpg',
  robots = 'index, follow',
  ogType = 'website',
  breadcrumbs,
  schema = [],
} = Astro.props;

const pageTitle = title === SITE.name ? title : `${title} | ${SITE.name}`;
const canonicalUrl = new URL(Astro.url.pathname, SITE.url).href;
const absoluteImage = new URL(image, SITE.url).href;

const ORG_ID = `${SITE.url}/#organization`;
const isHome = Astro.url.pathname === '/';
const preferredSourceContentRoutes = ['/blog', '/glossary', '/topics', '/resources', '/free-mcqs'];
const showPreferredSource =
  robots.startsWith('index') &&
  preferredSourceContentRoutes.some(
    (route) => Astro.url.pathname === route || Astro.url.pathname.startsWith(`${route}/`)
  );

/**
 * One @graph per page. The Organization node is the entity every other node
 * points at, so it ships site-wide rather than only on the homepage.
 */
const graph: Record<string, unknown>[] = [
  {
    '@type': 'Organization',
    '@id': ORG_ID,
    name: SITE.name,
    url: SITE.url,
    description: SITE.description,
    logo: { '@type': 'ImageObject', url: `${SITE.url}/logo.png` },
    sameAs: [
      'https://www.ophthamcq.com',
      'https://play.google.com/store/apps/details?id=com.bktxsx.ucjcrq',
      'https://apps.apple.com/in/app/ophtha-mcq-faico-ico-pdcet-frc/id6759045904',
    ],
  },
];

if (isHome) {
  graph.push({
    '@type': 'WebSite',
    '@id': `${SITE.url}/#website`,
    url: SITE.url,
    name: SITE.name,
    description: SITE.description,
    publisher: { '@id': ORG_ID },
    inLanguage: 'en',
  });
}

if (breadcrumbs?.length) {
  const trail = [{ name: 'Home', href: '/' }, ...breadcrumbs];
  graph.push({
    '@type': 'BreadcrumbList',
    '@id': `${canonicalUrl}#breadcrumbs`,
    itemListElement: trail.map((crumb, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: crumb.name,
      ...(crumb.href ? { item: new URL(crumb.href, SITE.url).href } : {}),
    })),
  });
}

graph.push(...schema);

const jsonLd = { '@context': 'https://schema.org', '@graph': graph };
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-959MHBVS4L"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-959MHBVS4L');
    </script>

    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content={robots} />
    <title>{pageTitle}</title>

    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="apple-touch-icon" href="/logo.png" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    {showPreferredSource && <GooglePreferredSource />}

    <script>
      function getSiteGrid() {
        const raw = getComputedStyle(document.documentElement).getPropertyValue('--site-grid').trim();
        const n = parseFloat(raw);
        return Number.isFinite(n) && n > 0 ? n : 48;
      }

      /**
       * Grow each gridded section so its total height is an exact multiple
       * of the grid cell. That way every cell is complete — no half-boxes
       * cut off at the bottom, and adjacent gridded sections join on a full line.
       */
      function snapGriddedSections() {
        const GRID = getSiteGrid();
        document.querySelectorAll('.section-skin-grid, .section-skin-blue').forEach((el) => {
          if (!(el instanceof HTMLElement)) return;
          // Heroes fill viewport on desktop — don't snap-grow them
          if (
            el.classList.contains('surface-slitlamp') ||
            el.classList.contains('contact-hero') ||
            el.classList.contains('site-hero') ||
            el.classList.contains('page-hero')
          ) {
            el.style.setProperty('--grid-snap-extra', '0px');
            el.style.removeProperty('padding-top');
            el.style.removeProperty('padding-bottom');
            return;
          }
          // Reset extra, measure natural height, then add remainder
          el.style.setProperty('--grid-snap-extra', '0px');
          const h = el.getBoundingClientRect().height;
          const rem = Math.round(h) % GRID;
          if (rem !== 0) {
            el.style.setProperty('--grid-snap-extra', `${GRID - rem}px`);
          }
        });
      }

      function initPremiumMotion() {
        document.body.classList.add('js-ready');

        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // Header scroll elevation
        const header = document.querySelector('.site-header');
        if (header) {
          const onScroll = () => {
            header.classList.toggle('is-scrolled', window.scrollY > 8);
          };
          onScroll();
          window.addEventListener('scroll', onScroll, { passive: true });
        }

        const main = document.querySelector('main');
        if (main) {
          // Alternating section skins: grid → clean → blue → …
          const skins = ['section-skin-grid', 'section-skin-clean', 'section-skin-blue'];
          let skinIndex = 0;
          main.querySelectorAll(':scope > section, :scope > div').forEach((el) => {
            if (!(el instanceof HTMLElement)) return;
            if (!el.children.length) return;

            // Heroes keep their own look/padding — never force section-skin 144px pad
            if (
              el.classList.contains('site-hero') ||
              el.classList.contains('page-hero') ||
              el.classList.contains('contact-hero') ||
              el.classList.contains('surface-slitlamp')
            ) {
              // Ensure a grid wash on plain page heroes without the 3-cell padding
              if (
                !el.classList.contains('section-skin-grid') &&
                !el.classList.contains('section-skin-clean') &&
                !el.classList.contains('section-skin-blue') &&
                !el.classList.contains('surface-slitlamp')
              ) {
                el.classList.add('section-skin-grid');
              }
              skinIndex = 1; // next non-hero section starts on "clean"
              return;
            }

            if (
              el.classList.contains('section-skin-grid') ||
              el.classList.contains('section-skin-clean') ||
              el.classList.contains('section-skin-blue') ||
              el.classList.contains('surface-ink')
            ) {
              if (el.classList.contains('section-skin-grid')) skinIndex = 1;
              else if (el.classList.contains('section-skin-clean')) skinIndex = 2;
              else if (el.classList.contains('section-skin-blue')) skinIndex = 0;
              return;
            }
            [...el.classList].forEach((c) => {
              if (
                c === 'bg-white' ||
                c.startsWith('bg-white/') ||
                c.startsWith('bg-slate-50') ||
                c.startsWith('bg-slate-100')
              ) {
                el.classList.remove(c);
              }
            });
            el.classList.add(skins[skinIndex % 3]);
            skinIndex += 1;
          });

          main.querySelectorAll(':scope > section, :scope > div').forEach((el, i) => {
            if (el.hasAttribute('data-reveal') || el.hasAttribute('data-stagger')) return;
            if (!(el instanceof HTMLElement)) return;
            if (!el.children.length) return;
            el.setAttribute('data-reveal', '');
            if (i > 0) el.style.setProperty('--reveal-delay', `${Math.min(i * 40, 200)}ms`);
          });

          main.querySelectorAll('.grid').forEach((grid) => {
            if (grid.hasAttribute('data-stagger')) return;
            if (grid.closest('.review-marquee')) return;
            const kids = grid.children.length;
            if (kids >= 2 && kids <= 12) {
              grid.setAttribute('data-stagger', '');
            }
          });
        }

        // Snap heights after layout (fonts/images) so cells are whole
        requestAnimationFrame(() => {
          snapGriddedSections();
          requestAnimationFrame(snapGriddedSections);
        });
        window.addEventListener('resize', snapGriddedSections, { passive: true });
        // Images/fonts can change height after first paint
        window.addEventListener('load', snapGriddedSections, { once: true });

        const targets = document.querySelectorAll('[data-reveal], [data-stagger]');

        if (reduce) {
          targets.forEach((el) => el.classList.add('is-visible'));
          return;
        }

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -6% 0px', threshold: 0.06 }
        );

        targets.forEach((el) => observer.observe(el));

        window.setTimeout(() => {
          targets.forEach((el) => el.classList.add('is-visible'));
          snapGriddedSections();
        }, 2500);
      }

      initPremiumMotion();
      document.addEventListener('astro:page-load', initPremiumMotion);
    </script>
  </body>
</html>
